{
  "manifest_version": 3,
  "name": "Fluent Steam Lua 一键入库",
  "version": "1.4.0",
  "description": "在 Steam 商店游戏页面直接生成 Lua 入库文件，需要配合 FluentLuaBridge 常驻服务使用。",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://store.steampowered.com/*",
    "http://127.0.0.1:27361/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/app/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "inject.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
