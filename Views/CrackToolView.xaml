<UserControl xmlns:controls="clr-namespace:SteamLuaManager.Controls" x:Class="SteamLuaManager.Views.CrackToolView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SteamLuaManager.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,24,36,24" HorizontalAlignment="Stretch">

            <!-- 页面标题 -->
            <TextBlock Text="{l:Loc Crack_Title}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="{l:Loc Crack_Desc}"
                       FontSize="12" Margin="0,0,0,2" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="{l:Loc Crack_Warn}"
                       FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <!-- 路径卡片 -->
            <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                </Border.Background>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,8,0" Height="36">
                            <TextBox x:Name="PathBox" Text="{Binding InputPath, Mode=OneWay}"
                                     IsReadOnly="True" Padding="8,6"
                                     FontSize="14" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"
                                     ToolTip="{l:Loc Crack_PathTip}">
                                <TextBox.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </TextBox.Background>
                            </TextBox>
                            <TextBlock Text="{l:Loc Crack_PathWatermark}" FontSize="14"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=PathBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="1" Command="{Binding BrowseFolderCommand}"
                                Padding="16,6" Height="36" FontSize="14" Margin="8,0,0,0"
                                Content="{l:Loc Crack_BrowseDir}"/>
                        <Button Grid.Column="2" Command="{Binding ClearLogCommand}"
                                Padding="16,6" Height="36" FontSize="14" Margin="8,0,0,0"
                                Content="{l:Loc Common_ClearLog}"/>
                    </Grid>
                    <Grid Margin="0,12,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="80"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc Crack_AppIdLabel}" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBox Grid.Column="1" Text="{Binding AppId, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" Height="32" FontSize="13" Width="140"
                                 VerticalContentAlignment="Center"
                                 ToolTip="{l:Loc Crack_AppIdTip}"/>
                        <Button Grid.Column="2" Command="{Binding QueryAppIdCommand}"
                                Padding="16,6" Height="32" FontSize="13" Margin="8,0,0,0"
                                Content="{l:Loc Crack_QueryAppId}"
                                ToolTip="{l:Loc Crack_QueryAppIdTip}"/>
                        <TextBlock Grid.Column="3" Text="{l:Loc Crack_KeyLabel}" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="{l:Loc Crack_KeyTip}"/>
                        <TextBox Grid.Column="4" Text="{Binding WebApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" Height="32" FontSize="13" Margin="8,0,0,0"
                                 VerticalContentAlignment="Center" HorizontalAlignment="Stretch"
                                 ToolTip="{l:Loc Crack_KeyTip}"/>
                        <Button Grid.Column="5" Command="{Binding OpenApiKeyPageCommand}"
                                Padding="16,6" Height="32" FontSize="13" Margin="8,0,0,0"
                                Content="{l:Loc Crack_GetKey}"
                                ToolTip="{l:Loc Crack_GetKeyTip}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox IsChecked="{Binding IsUnpackOnly}" Content="{l:Loc Crack_UnpackOnly}" FontSize="14"
                                  VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="0"
                                  ToolTip="{l:Loc Crack_UnpackOnlyTip}"/>
                        <Button Command="{Binding CrackCommand}"
                                Padding="16,6" Height="36" FontSize="14" Margin="0,0,6,0"
                                Content="{Binding CrackButtonText}"
                                ToolTip="{l:Loc Crack_CrackTip}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource BoolInvertConverter}}"/>
                        <Button Command="{Binding RestoreCommand}"
                                Padding="16,6" Height="36" FontSize="14" Margin="6,0,6,0"
                                Content="{l:Loc Crack_Restore}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource BoolInvertConverter}}"/>
                        <Button Command="{Binding UpdateEmuCommand}"
                                Padding="16,6" Height="36" FontSize="14" Margin="6,0,0,0"
                                Content="{Binding EmuButtonText}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource BoolInvertConverter}}"/>
                        <TextBlock Text="{Binding EmuVersionText}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Button Command="{Binding CancelCommand}"
                                Padding="16,6" Height="36" FontSize="14" Margin="6,0,0,0"
                                Content="{l:Loc Common_Cancel}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                    <ui:ProgressRing IsActive="{Binding IsRunning}" Width="20" Height="20"
                                     HorizontalAlignment="Left" Margin="0,8,0,0"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- 日志区域 -->
            <Border CornerRadius="10" Padding="0"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,8">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                </Border.Background>
                <Grid>
                    <TextBlock Text="{l:Loc Common_NoLog}" Style="{StaticResource LogEmptyStyle}"
                               Visibility="{Binding LogLines.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                    <ScrollViewer x:Name="LogScrollViewer" Height="370"
                                  VerticalScrollBarVisibility="Auto" Margin="16,16,16,16"
                                  PreviewMouseWheel="LogScrollViewer_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource LogTextStyle}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <ui:InfoBar Style="{StaticResource InfoBarStyle}"
                        IsOpen="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                        Message="{Binding StatusMessage}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"/>
        </StackPanel>
    </controls:SmoothScrollViewer>
</UserControl>
