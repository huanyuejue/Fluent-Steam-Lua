<Window x:Class="SteamLuaManager.Views.AppIdQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SteamLuaManager.Controls"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="查询 AppID" Width="560" Height="480" MinWidth="440" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyboardNavigation.DirectionalNavigation="Cycle"
        KeyboardNavigation.TabNavigation="Cycle">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="用游戏目录名搜索候选，选中后自动填入 AppID"/>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:AutoSuggestBox Grid.Column="0" x:Name="SearchBox"
                               Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PlaceholderText="输入游戏英文名" Padding="8,6" Height="36" FontSize="14" Margin="0,0,8,0"
                                VerticalContentAlignment="Center"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
                <ui:AutoSuggestBox.Background>
                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                </ui:AutoSuggestBox.Background>
            </ui:AutoSuggestBox>
            <Button Grid.Column="1" Command="{Binding SearchCommand}"
                    Padding="16,6" Height="36" FontSize="14"
                    IsEnabled="{Binding IsSearching, Converter={StaticResource BoolInvertConverter}}"
                    Content="搜索"
                    FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
        </Grid>

        <controls:SmoothScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ui:ProgressRing IsActive="{Binding IsSearching}" Width="28" Height="28"
                                 HorizontalAlignment="Center" Margin="0,8"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="AppID: "/><Run Text="{Binding AppId, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Padding="16,6" Height="34" FontSize="13"
                                            Content="选择"
                                            FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </controls:SmoothScrollViewer>
    </Grid>
</Window>
