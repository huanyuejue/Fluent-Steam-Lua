<Window x:Class="SteamLuaManager.Views.FaqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SteamLuaManager.Controls"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="常见问题" Width="520" Height="640" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyboardNavigation.DirectionalNavigation="Cycle"
        KeyboardNavigation.TabNavigation="Cycle">
    <Window.Resources>
        <!-- 标题栏开关：全透明，无悬停无选中染色 -->
        <Style x:Key="FaqHeaderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6" BorderThickness="0">
                            <ContentPresenter ContentSource="Content"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 带伸缩动画的手风琴：内容区 LayoutTransform.ScaleY 0↔1，布局跟着长，不跳变；
             箭头同步旋转，内容淡入 -->
        <Style x:Key="AnimatedExpanderStyle" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border CornerRadius="8" Padding="12,7" Margin="0,0,0,6"
                                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                            </Border.Background>
                            <StackPanel>
                                <ToggleButton x:Name="HeaderSite" Style="{StaticResource FaqHeaderToggleStyle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Grid.Column="0" ContentSource="Header"
                                                          VerticalAlignment="Center"/>
                                        <Path Grid.Column="1" Margin="10,0,2,0" VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                              StrokeThickness="1.6" Width="10" Height="8" Stretch="Uniform"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="ChevronRotate" Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </ToggleButton>
                                <Grid x:Name="ContentGrid" Margin="0,6,0,4">
                                    <Grid.LayoutTransform>
                                        <ScaleTransform x:Name="ContentScale" ScaleY="0"/>
                                    </Grid.LayoutTransform>
                                    <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Opacity="0"
                                                      RenderTransformOrigin="0.5,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Trigger.EnterActions>
                                    <StopStoryboard BeginStoryboardName="CollapseBS"/>
                                    <BeginStoryboard x:Name="ExpandBS">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ExpandSite"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="180" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="ExpandBS"/>
                                    <BeginStoryboard x:Name="CollapseBS">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ExpandSite"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:AutoSuggestBox Grid.Row="0" x:Name="SearchBox"
                           Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="搜索问题关键字…" Padding="8,6" Height="36" FontSize="14" Margin="0,0,0,12"
                           VerticalContentAlignment="Center"
                           FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
            <ui:AutoSuggestBox.Background>
                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
            </ui:AutoSuggestBox.Background>
            <ui:AutoSuggestBox.QueryIcon>
                <ui:FontIcon Glyph="&#xE721;"/>
            </ui:AutoSuggestBox.QueryIcon>
        </ui:AutoSuggestBox>

        <controls:SmoothScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,16,0">
                <ItemsControl ItemsSource="{Binding FilteredFaqs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Style="{StaticResource AnimatedExpanderStyle}"
                                      IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock Text="{Binding Question}" FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Expander.Header>
                                <Expander.Content>
                                    <Border CornerRadius="6" Padding="10"
                                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                        <TextBox Text="{Binding Answer, Mode=OneWay}" IsReadOnly="True"
                                                 FontSize="13" TextWrapping="Wrap" BorderThickness="0"
                                                 IsInactiveSelectionHighlightEnabled="True"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                 FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
                                            <TextBox.Background>
                                                <SolidColorBrush Color="Transparent"/>
                                            </TextBox.Background>
                                        </TextBox>
                                    </Border>
                                </Expander.Content>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="没有匹配的问题，去聊天反馈群问问吧"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding FilteredFaqs.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
            </StackPanel>
        </controls:SmoothScrollViewer>
    </Grid>
</Window>
