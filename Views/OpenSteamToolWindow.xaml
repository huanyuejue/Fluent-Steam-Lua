<Window x:Class="SteamLuaManager.Views.OpenSteamToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SteamLuaManager.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="{l:Loc Ost_WindowTitle}" Width="780" Height="780" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- 卡片式操作按钮：整块可点；悬停走叠加层提亮，不覆盖底色，危险项的红底因此得以保留。
             内容全自定义（图标块 + 标题 + 说明 + 右箭头），底色与描边走 TemplateBinding -->
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="HoverLayer" CornerRadius="8" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            <ContentPresenter Margin="14,12" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="24,18,24,18">
            <StackPanel>

                <!-- 状态卡：四分栏，栏间竖线分隔 -->
                <Border CornerRadius="10" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,14">
                            <ui:FontIcon Glyph="&#xE713;" FontSize="20" VerticalAlignment="Top" Margin="0,3,12,0"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Ost_StatusKernel}" FontSize="12.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Border x:Name="KernelStatePill" Margin="0,6,0,0" HorizontalAlignment="Left"
                                        CornerRadius="10" Padding="9,2">
                                    <TextBlock x:Name="KernelStateText" FontSize="12.5" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Width="1" Margin="0,14"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,14">
                            <ui:FontIcon Glyph="&#xE7B8;" FontSize="20" VerticalAlignment="Top" Margin="0,3,12,0"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Ost_StatusVersion}" FontSize="12.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="KernelVersionText" FontSize="14.5" FontWeight="SemiBold" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="3" Width="1" Margin="0,14"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,14">
                            <ui:FontIcon Glyph="&#xE77B;" FontSize="20" VerticalAlignment="Top" Margin="0,3,12,0"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Ost_StatusInject}" FontSize="12.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="InjectModeText" FontSize="14.5" FontWeight="SemiBold" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="5" Width="1" Margin="0,14"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                        <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="16,14">
                            <ui:FontIcon Glyph="&#xE8B7;" FontSize="20" VerticalAlignment="Top" Margin="0,3,12,0"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Ost_StatusSteamPath}" FontSize="12.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="SteamPathText" FontSize="14.5" FontWeight="SemiBold" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 注入方式切换 -->
                <Border CornerRadius="10" BorderThickness="1" Margin="0,14,0,0" Padding="18,16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE945;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{l:Loc Ost_InjectTitle}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{l:Loc Ost_InjectDesc}" FontSize="12.5" Margin="0,6,0,14"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <!-- 入口配置异常横幅：缺入口 / 双入口冲突各一句引导，正常态隐藏。
                             用 Grid 而非横向 StackPanel，文本列才能拿到受限宽度正常换行，不被裁切 -->
                        <Border x:Name="InjectWarningBar" Visibility="Collapsed" CornerRadius="8" Padding="12,10" Margin="0,0,0,14"
                                Background="#1FE8C300" BorderBrush="#66E8C300" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="16" Margin="0,1,10,0"
                                             VerticalAlignment="Top" Foreground="#FFE8C300"/>
                                <TextBlock Grid.Column="1" x:Name="InjectWarningText" TextWrapping="Wrap" FontSize="12.5"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- dwmapi（推荐） -->
                            <Border x:Name="DwmapiCard" Grid.Column="0" CornerRadius="8" Padding="14,12"
                                    Cursor="Hand" MouseLeftButtonUp="DwmapiCard_Click" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"
                                            VerticalAlignment="Center" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <ui:FontIcon Glyph="&#xE7C4;" FontSize="18" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{l:Loc Ost_InjectDwmapiName}" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Border x:Name="DwmapiBadge" Margin="8,0,0,0" Padding="7,2" CornerRadius="9"
                                                VerticalAlignment="Center" Visibility="Collapsed"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="{l:Loc Ost_InjectCurrent}" FontSize="10.5" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <Border x:Name="DwmapiCheck" Grid.Row="0" Grid.Column="2" Width="20" Height="20" CornerRadius="10"
                                            Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <ui:FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                               Text="{l:Loc Ost_InjectDwmapiDesc}" FontSize="12" Margin="0,8,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Border>

                            <!-- version（首载隔离） -->
                            <Border x:Name="VersionCard" Grid.Column="2" CornerRadius="8" Padding="14,12"
                                    Cursor="Hand" MouseLeftButtonUp="VersionCard_Click" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"
                                            VerticalAlignment="Center" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <ui:FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{l:Loc Ost_InjectVersionName}" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Border x:Name="VersionBadge" Margin="8,0,0,0" Padding="7,2" CornerRadius="9"
                                                VerticalAlignment="Center" Visibility="Collapsed"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="{l:Loc Ost_InjectCurrent}" FontSize="10.5" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <Border x:Name="VersionCheck" Grid.Row="0" Grid.Column="2" Width="20" Height="20" CornerRadius="10"
                                            Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <ui:FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                               Text="{l:Loc Ost_InjectVersionDesc}" FontSize="12" Margin="0,8,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 内核管理 -->
                <Border CornerRadius="10" BorderThickness="1" Margin="0,14,0,0" Padding="18,16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE71D;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{l:Loc Ost_ActionsTitle}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{l:Loc Ost_ActionsDesc}" FontSize="12.5" Margin="0,6,0,14"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 安装 -->
                            <Button x:Name="InstallButton" Grid.Row="0" Grid.Column="0"
                                    Style="{StaticResource TileButtonStyle}" Click="InstallButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <ui:FontIcon Glyph="&#xE896;" FontSize="18" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{l:Loc Main_KmInstall}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{l:Loc Ost_ActionInstallDesc}" FontSize="12" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ui:FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Button>

                            <!-- 更新 -->
                            <Button x:Name="UpdateButton" Grid.Row="0" Grid.Column="2"
                                    Style="{StaticResource TileButtonStyle}" Click="UpdateButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <ui:FontIcon Glyph="&#xE72C;" FontSize="18" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{l:Loc Main_KmUpdate}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{l:Loc Ost_ActionUpdateDesc}" FontSize="12" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ui:FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Button>

                            <!-- 禁用/启用内核 -->
                            <Button x:Name="ToggleButton" Grid.Row="2" Grid.Column="0"
                                    Style="{StaticResource TileButtonStyle}" Click="ToggleButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <ui:FontIcon Glyph="&#xE7E8;" FontSize="18" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="ToggleTitleText" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{l:Loc Ost_ActionDisableDesc}" FontSize="12" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ui:FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Button>

                            <!-- 净化环境 -->
                            <Button x:Name="PurifyButton" Grid.Row="2" Grid.Column="2"
                                    Style="{StaticResource TileButtonStyle}" Click="PurifyButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <ui:FontIcon Glyph="&#xE894;" FontSize="18" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{l:Loc Main_KmPurify}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{l:Loc Ost_ActionPurifyDesc}" FontSize="12" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ui:FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Button>

                            <!-- 一键获取 toml -->
                            <Button x:Name="FetchTomlButton" Grid.Row="4" Grid.Column="0"
                                    Style="{StaticResource TileButtonStyle}" Click="FetchTomlButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <ui:FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{l:Loc Main_KmFetch}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{l:Loc Ost_ActionFetchDesc}" FontSize="12" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ui:FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Button>

                            <!-- 卸载：红色描边+淡红底 -->
                            <Button x:Name="UninstallButton" Grid.Row="4" Grid.Column="2"
                                    Style="{StaticResource TileButtonStyle}" Click="UninstallButton_Click"
                                    Background="#1FC42B1C" BorderBrush="#66C42B1C">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <ui:FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{l:Loc Main_KmUninstall}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{l:Loc Ost_ActionUninstallDesc}" FontSize="12" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ui:FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 内核安装/更新遮罩层 -->
        <Grid x:Name="KernelOverlayGrid" Panel.ZIndex="210"
              Visibility="Collapsed" Background="#80000000" IsHitTestVisible="True">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="400" MinHeight="150" CornerRadius="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Margin="24,20">
                    <TextBlock x:Name="KernelOverlayStatus" FontSize="14" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="KernelOverlayHint" FontSize="11" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0" Visibility="Collapsed"
                               Text="{l:Loc Overlay_SlowHint}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="KernelOverlayProgressBar" Minimum="0" Maximum="100" Value="0"
                                     Height="6" Visibility="Collapsed"/>
                        <TextBlock x:Name="KernelOverlayPercent" Grid.Column="1" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="10,0,0,0" Visibility="Collapsed" Text="0%"/>
                    </Grid>
                    <ui:ProgressRing x:Name="KernelOverlayRing" IsActive="True" Width="28" Height="28"
                                     Margin="0,12,0,0" HorizontalAlignment="Left"/>
                    <Button x:Name="KernelCancelButton" Content="{l:Loc Common_Cancel}" Margin="0,14,0,0"
                            Padding="12,6" FontSize="13" HorizontalAlignment="Center"
                            Click="KernelCancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
