<UserControl x:Class="SteamLuaManager.Views.AchievementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:controls="clr-namespace:SteamLuaManager.Controls"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="成就管理" FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="双击卡片打开成就编辑" FontSize="12"
                               Margin="12,14,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <TextBlock Text="{Binding GameCountText}" FontSize="13" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="刷新游戏列表" VerticalAlignment="Center"
                    Command="{Binding LoadGamesCommand}" IsEnabled="{Binding IsLoadingGames, Converter={StaticResource BoolInvertConverter}}"
                    Padding="16,6" Height="36" FontSize="14">
                <Button.Background>
                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                </Button.Background>
            </Button>
        </Grid>

        <!-- 搜索 + 视图 + 排序 -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:AutoSuggestBox Grid.Column="0" PlaceholderText="搜索游戏名或 AppID，回车或点放大镜搜索"
                               Text="{Binding SearchText, Mode=TwoWay}"
                               QuerySubmitted="SearchBox_QuerySubmitted"
                               TextChanged="SearchBox_TextChanged"
                               Margin="0,0,12,0" HorizontalAlignment="Stretch">
                <ui:AutoSuggestBox.Background>
                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                </ui:AutoSuggestBox.Background>
                <ui:AutoSuggestBox.QueryIcon>
                    <ui:FontIcon Glyph="&#xE721;"/>
                </ui:AutoSuggestBox.QueryIcon>
            </ui:AutoSuggestBox>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                <TextBlock Text="视图:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="ViewModeComboBox" ItemsSource="{Binding ViewModeOptions}"
                          SelectedItem="{Binding SelectedViewMode, Mode=TwoWay}"
                          SelectionChanged="ViewModeComboBox_SelectionChanged"
                          Padding="12,6" HorizontalContentAlignment="Center">
                    <ComboBox.Background>
                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                    </ComboBox.Background>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="排序:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="SortComboBox" ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                          SelectionChanged="SortComboBox_SelectionChanged"
                          MinWidth="132" Padding="12,6" HorizontalContentAlignment="Center">
                    <ComboBox.Background>
                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                    </ComboBox.Background>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- 卡片区 -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="CardsScrollViewer" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Loaded="CardsScrollViewer_Loaded"
                          ScrollChanged="GamesScrollViewer_ScrollChanged"
                          IsVisibleChanged="CardsScrollViewer_IsVisibleChanged"
                          Visibility="{Binding IsLoadingGames, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                <ItemsControl x:Name="CardsItemsControl" ItemsSource="{Binding Games}" Margin="0,0,-14,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ClippingBorder Width="200" Margin="0,0,14,14" CornerRadius="10"
                                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Tag="{Binding}"
                                    Cursor="Hand"
                                    MouseDoubleClick="Card_MouseDoubleClick"
                                    ToolTip="双击打开成就编辑">
                                <controls:ClippingBorder.Background>
                                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                                </controls:ClippingBorder.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="86"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Rectangle Fill="{DynamicResource ControlFillColorDefaultBrush}"/>
                                        <ui:FontIcon Glyph="&#xE7FC;" FontSize="36"
                                                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <controls:AsyncImage DeferLoading="True"
                                                             SourceUrl="{Binding CoverUrl}"
                                                             Stretch="UniformToFill"
                                                             RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding Name}"
                                               FontWeight="SemiBold" FontSize="14"
                                               Margin="12,10,12,2" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                    <TextBlock Grid.Row="2" FontSize="12" Margin="12,0,12,10"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="AppID: "/>
                                        <Run Text="{Binding AppId, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </controls:ClippingBorder>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 列表模式：纯文字行，无封面 -->
            <ScrollViewer x:Name="ListScrollViewer" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="GamesScrollViewer_ScrollChanged"
                          Padding="0,0,20,0">
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="AppID: "/>
                                            <Run Text="{Binding AppId, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="成就管理" Tag="{Binding}"
                                            Click="ListItemEditButton_Click"
                                            Padding="12,6" VerticalAlignment="Center">
                                        <Button.Background>
                                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                        </Button.Background>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                        Visibility="{Binding Games.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                <ui:ProgressRing IsActive="{Binding IsLoadingGames}" Width="32" Height="32" Margin="0,0,0,12"/>
                <TextBlock Text="双击游戏卡片，在独立窗口中编辑成就" FontSize="14" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>

            <ui:InfoBar VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0"
                        Panel.ZIndex="10"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        IsOpen="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                        Message="{Binding StatusMessage}"
                        Severity="Informational"
                        IsClosable="False"
                        ui:ControlHelper.CornerRadius="8">
                <ui:InfoBar.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Style>
                </ui:InfoBar.Resources>
            </ui:InfoBar>
        </Grid>
    </Grid>
</UserControl>
