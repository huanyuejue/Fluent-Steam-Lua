<UserControl xmlns:controls="clr-namespace:SteamLuaManager.Controls" x:Class="SteamLuaManager.Views.OnlineFixView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SteamLuaManager.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="PillButtonStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6" BorderThickness="0">
                            <ContentPresenter ContentSource="Content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{l:Loc Online_Title}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="{l:Loc Online_Desc480}"
                       FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding IsShowing480, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <StackPanel Visibility="{Binding IsShowingPatch, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{l:Loc Online_DescPatch1}"
                           FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{l:Loc Online_DescPatch2}"
                           FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{l:Loc Online_DescPatch3}"
                           FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- 顶部切换 Pills -->
        <Border Grid.Row="1" CornerRadius="8" Padding="4" Margin="0,0,0,12" Height="40"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" Content="{l:Loc Online_Pill480}"
                             IsChecked="{Binding IsShowing480}"
                             Style="{StaticResource PillButtonStyle}"
                             Command="{Binding Show480ViewCommand}"/>
                <RadioButton Grid.Column="1" Content="{l:Loc Online_PillPatch}"
                             IsChecked="{Binding IsShowingPatch}"
                             Style="{StaticResource PillButtonStyle}"
                             Command="{Binding ShowPatchViewCommand}"/>
            </Grid>
        </Border>

        <!-- 滚动内容 -->
        <controls:SmoothScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,14,0">
            <StackPanel>

                <!-- ===== 480 联机 ===== -->
                <StackPanel x:Name="Content480Panel"
                            Visibility="{Binding IsShowing480, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Online_WhatIs480}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{l:Loc Online_WhatIs480Body}"/>
                            <TextBlock Text="{l:Loc Online_StepsTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,2"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{l:Loc Online_Step1}"/>
                            <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,2"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{l:Loc Online_Step2}"/>
                            <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{l:Loc Online_Step3}"/>
                            <TextBox Text="-onlinefix" IsReadOnly="True" FontSize="14" FontFamily="Consolas, Consolas, Microsoft YaHei"
                                     Padding="10,8" Margin="0,0,0,8" MaxWidth="280" HorizontalAlignment="Left"
                                     ToolTip="{l:Loc Online_CopyParamTip}">
                                <TextBox.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </TextBox.Background>
                            </TextBox>
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{l:Loc Online_Limit}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== OnlineFix 补丁 ===== -->
                <StackPanel x:Name="ContentPatchPanel"
                            Visibility="{Binding IsShowingPatch, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- 搜索卡片 -->
                    <Border CornerRadius="10" Padding="12" Margin="0,0,0,12"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:AutoSuggestBox Grid.Column="0" x:Name="SearchBox"
                                               Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               PlaceholderText="{l:Loc Online_SearchPlaceholder}"
                                               QuerySubmitted="SearchBox_QuerySubmitted"
                                               TextChanged="SearchBox_TextChanged"
                                               Height="36"
                                               Margin="0,0,8,0" HorizontalAlignment="Stretch">
                                <ui:AutoSuggestBox.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </ui:AutoSuggestBox.Background>
                                <ui:AutoSuggestBox.QueryIcon>
                                    <ui:FontIcon Glyph="&#xE721;"/>
                                </ui:AutoSuggestBox.QueryIcon>
                            </ui:AutoSuggestBox>
                            <Button Grid.Column="1" Command="{Binding ClearLogCommand}"
                                    Padding="16,6" Height="36" FontSize="14">
                                <Button.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </Button.Background>
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE74D;" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="{l:Loc Common_ClearLog}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 日志区域（固定在搜索框下方） -->
                    <Border CornerRadius="10" Padding="0"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,8">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                        </Border.Background>
                        <Grid>
                            <TextBlock Text="{l:Loc Common_NoLog}" Style="{StaticResource LogEmptyStyle}"
                                       Visibility="{Binding LogLines.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Disabled" Margin="16,16,16,16"
                                          PreviewMouseWheel="LogScrollViewer_PreviewMouseWheel">
                                <ItemsControl ItemsSource="{Binding LogLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource LogTextStyle}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button x:Name="CopyLogButton" Content="{l:Loc Common_CopyLog}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,8,8,0" Padding="8,4" FontSize="12"
                                    Click="CopyLogButton_Click" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- 搜索中加载指示 -->
                    <ui:ProgressRing IsActive="{Binding IsSearching}" Width="28" Height="28"
                                     HorizontalAlignment="Center" Margin="0,0,0,8"
                                     Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- 搜索结果 -->
                    <ItemsControl ItemsSource="{Binding SearchResults}" Margin="0,0,0,8"
                                  Visibility="{Binding SearchResults.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <Run Text="{Binding Tablet, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding VersionText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Command="{Binding DataContext.LoadDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="16,6" Height="36"                                                 FontSize="14" Focusable="False"
                                                Content="{l:Loc Online_ViewPatch}">
                                            <Button.Background>
                                                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                            </Button.Background>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 搜过但无结果 -->
                    <TextBlock Text="{l:Loc Online_SearchEmpty}"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,16"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsSearchEmptyVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- 详情加载指示 -->
                    <ui:ProgressRing IsActive="{Binding IsLoadingDetail}" Width="28" Height="28"
                                     HorizontalAlignment="Center" Margin="0,0,0,8"
                                     Visibility="{Binding IsLoadingDetail, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- 补丁详情 -->
                    <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                            Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="{Binding Detail.Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock FontSize="12" Margin="0,0,0,2"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{l:Loc Online_DetailVersion}"/><Run Text="{Binding Detail.VersionText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Margin="0,0,0,2"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{l:Loc Online_DetailSource}"/><Run Text="{Binding Detail.Tablet, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Margin="0,0,0,2"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{l:Loc Online_PasswordNote}"/>
                            <TextBlock Text="{l:Loc Online_PasswordUsage}"
                                       FontSize="12" Margin="0,8,0,4"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Border CornerRadius="6" Padding="0" MaxHeight="220"
                                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                <TextBox Text="{Binding Detail.Instructions, Mode=OneWay}" IsReadOnly="True"
                                         FontSize="12" TextWrapping="Wrap" BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto"
                                         IsInactiveSelectionHighlightEnabled="True"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <TextBox.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.25"/>
                                    </TextBox.Background>
                                </TextBox>
                            </Border>
                            <TextBlock Text="{l:Loc Online_PatchDirNote}"
                                       FontSize="12" Margin="0,8,0,4"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{Binding Detail.Files}" Margin="0,0,0,4"
                                          Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                                    <Run Text="　"/>
                                                    <Run Text="{Binding DateText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                                <Button Grid.Column="1"
                                                        Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="20,8" Height="36" FontSize="14" Focusable="False"
                                                        IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolInvertConverter}}"
                                                        Content="{l:Loc Online_Download}">
                                                <Button.Background>
                                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                                </Button.Background>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{l:Loc Online_GameDirNote}"
                                       FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasFiles, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                            <ProgressBar Minimum="0" Maximum="100" Height="6" Margin="0,8,0,0"
                                         Value="{Binding DownloadProgress}"
                                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Content="{l:Loc Online_CancelDownload}" Command="{Binding CancelDownloadCommand}"
                                    Padding="16,6" Height="32" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 底部通知 -->
                    <ui:InfoBar Style="{StaticResource InfoBarStyle}"
                                IsOpen="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                                Message="{Binding StatusMessage}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12"/>
                </StackPanel>
            </StackPanel>
        </controls:SmoothScrollViewer>
    </Grid>
</UserControl>
