<UserControl xmlns:controls="clr-namespace:SteamLuaManager.Controls" x:Class="SteamLuaManager.Views.CloudSaveView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyboardNavigation.DirectionalNavigation="Cycle"
        KeyboardNavigation.TabNavigation="Cycle">

    <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,24,36,24">

            <TextBlock Text="云存档重定向" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="将Lua游戏的Steam云存档重定向到本地目录或云端存储（Google Drive / OneDrive / R2 / S3），以修复云存档报错问题"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="启用前请先备份重要存档以防出错；开关、目录与服务商变更需重启Steam生效；成就与时长跟随云端同步"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="注意：该功能需要电脑已安装VC++运行库才能正常工作"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <ui:SettingsCard Header="云存档" Margin="0,0,0,8"
                             Description="开启后 Lua 游戏存档将重定向到所选位置"
                             Style="{StaticResource SettingsCardStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="测试连接" Command="{Binding TestConnectionCommand}"
                                Padding="12,4" Margin="0,0,8,0" VerticalAlignment="Center"
                                Visibility="{Binding IsCloudProvider, Converter={StaticResource BoolToVisibilityConverter}}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}"
                                FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
                            <Button.Background>
                                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                            </Button.Background>
                        </Button>
                        <ComboBox ItemsSource="{Binding CloudProviders}"
                                  SelectedValue="{Binding SelectedProvider}"
                                  SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                  Padding="8,4" MinWidth="140" Margin="0,0,12,0" VerticalAlignment="Center"
                                  FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
                        <ComboBox.Background>
                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                        </ComboBox.Background>
                    </ComboBox>
                    <ui:ToggleSwitch IsOn="{Binding IsCloudEnabled, Mode=TwoWay}"
                                     IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}"
                                     OnContent="开" OffContent="关" VerticalAlignment="Center"
                                     FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                </StackPanel>
            </ui:SettingsCard>
            <TextBlock Text="{Binding ProviderStatusLine}" FontSize="12" Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding ProviderStatusLine, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

            <ui:SettingsCard Header="本地重定向目录" Margin="0,0,0,8"
                                     Description="云存档在本地的落盘位置"
                                     Style="{StaticResource SettingsCardStyle}"
                                     Visibility="{Binding SelectedProvider, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=folder}">
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding SyncPathText, Mode=OneWay}"
                             ToolTip="{Binding SyncPathText}"
                             IsReadOnly="True" Width="240" Padding="8,6" Margin="0,0,4,0"
                             FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
                        <TextBox.Background>
                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                        </TextBox.Background>
                    </TextBox>
                    <Button Content="自定义" Command="{Binding BrowseSyncPathCommand}"
                            Padding="12,6" Margin="4,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}"
                            FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
                        <Button.Background>
                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                        </Button.Background>
                    </Button>
                    <Button Content="重置" Command="{Binding ResetSyncPathCommand}"
                            Padding="12,6" Margin="4,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}"
                            FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
                        <Button.Background>
                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </ui:SettingsCard>

                <!-- OAuth 登录面板：Google Drive / OneDrive -->
                <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{Binding SelectedProvider, Converter={StaticResource OAuthProviderVisibilityConverter}, ConverterParameter=gdrive|onedrive}">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                    </Border.Background>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="登录" Padding="20,6" Margin="0,0,8,0"
                                        Command="{Binding SignInCommand}"
                                        Visibility="{Binding IsProviderSignedIn, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                        IsEnabled="{Binding IsSigningIn, Converter={StaticResource BoolInvertConverter}}"
                                        FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                                <Button Content="切换账号" Padding="20,6" Margin="0,0,8,0"
                                        Command="{Binding SignInCommand}"
                                        Visibility="{Binding IsProviderSignedIn, Converter={StaticResource BoolToVisibilityConverter}}"
                                        IsEnabled="{Binding IsSigningIn, Converter={StaticResource BoolInvertConverter}}"
                                        FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                                <Button Content="退出登录" Padding="20,6" Margin="0,0,8,0"
                                        Command="{Binding SignOutCommand}"
                                        Visibility="{Binding IsProviderSignedIn, Converter={StaticResource BoolToVisibilityConverter}}"
                                        FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
                                    <Button.Foreground>
                                        <SolidColorBrush Color="#E74856"/>
                                    </Button.Foreground>
                                </Button>
                                <Button Content="取消" Padding="20,6"
                                        Command="{Binding CancelSignInCommand}"
                                        IsEnabled="{Binding IsSigningIn}"
                                        FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            </StackPanel>
                            <Button Content="清空" Padding="20,6" HorizontalAlignment="Right"
                                    Command="{Binding ClearAuthLogCommand}"
                                    IsEnabled="{Binding IsSigningIn, Converter={StaticResource BoolInvertConverter}}"
                                    FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                        </Grid>
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding AuthLogLines.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding AuthLogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas,微软雅黑" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,1"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- R2 凭证表单 -->
                <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{Binding SelectedProvider, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=r2}">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                    </Border.Background>
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Account ID *" VerticalAlignment="Center" FontSize="12" Margin="0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding R2AccountId, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"
                                     FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Access Key ID *" VerticalAlignment="Center" FontSize="12" Margin="0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding R2AccessKeyId, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"
                                     FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Secret Key *" VerticalAlignment="Center" FontSize="12" Margin="0,4"/>
                            <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="R2SecretBox" Padding="8,6" Margin="0,4"
                                         PasswordChanged="R2SecretBox_PasswordChanged"
                                         FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Bucket *" VerticalAlignment="Center" FontSize="12" Margin="0,4"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding R2Bucket, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"
                                     FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Key Prefix" VerticalAlignment="Center" FontSize="12" Margin="0,4"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding R2KeyPrefix, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"
                                     FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Endpoint" VerticalAlignment="Center" FontSize="12" Margin="0,4"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding R2Endpoint, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"
                                     FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                        </Grid>
                        <TextBlock Text="Endpoint 留空则用默认地址；Key Prefix 为云端目录前缀，两台机器填一致才能互通"
                                   FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="保存 R2 凭证并切换" Padding="20,6" Margin="0,0,8,0"
                                    Command="{Binding SaveR2Command}"
                                    FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            <Button Content="清除凭证" Padding="20,6"
                                    Command="{Binding SignOutCommand}" CommandParameter="r2"
                                    Visibility="{Binding IsProviderSignedIn, Converter={StaticResource BoolToVisibilityConverter}}"
                                    FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
                                <Button.Foreground>
                                    <SolidColorBrush Color="#E74856"/>
                                </Button.Foreground>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- S3 凭证表单 -->
                <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{Binding SelectedProvider, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=s3}">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                    </Border.Background>
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Access Key ID *" VerticalAlignment="Center" FontSize="12" Margin="0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding S3AccessKeyId, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"
                                     FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Secret Key *" VerticalAlignment="Center" FontSize="12" Margin="0,4"/>
                            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="S3SecretBox" Padding="8,6" Margin="0,4"
                                         PasswordChanged="S3SecretBox_PasswordChanged"
                                         FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Bucket *" VerticalAlignment="Center" FontSize="12" Margin="0,4"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding S3Bucket, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"
                                     FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Endpoint *" VerticalAlignment="Center" FontSize="12" Margin="0,4"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding S3Endpoint, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"
                                     FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Region *" VerticalAlignment="Center" FontSize="12" Margin="0,4"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding S3Region, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"
                                     FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Key Prefix" VerticalAlignment="Center" FontSize="12" Margin="0,4"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding S3KeyPrefix, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"
                                     FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="CA 证书" VerticalAlignment="Center" FontSize="12" Margin="0,4"/>
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <TextBox Text="{Binding S3CaCertPath}" IsReadOnly="True" Width="220" Padding="8,6" Margin="0,0,8,0"
                                         FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                                <Button Content="选择" Padding="12,6" Command="{Binding BrowseCaCertCommand}"
                                        FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <CheckBox Content="携带签名载荷" IsChecked="{Binding S3SignPayload}" Margin="0,0,16,0"
                                          FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                                <CheckBox Content="允许 HTTP" IsChecked="{Binding S3AllowInsecureHttp}" Margin="0,0,16,0"
                                          FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                                <CheckBox Content="跳过 TLS 校验" IsChecked="{Binding S3AllowInsecureTls}"
                                          FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Endpoint 填带 https:// 的完整地址；Region 按服务商要求填写（如 us-east-1）；Key Prefix 两台机器填一致才能互通；“携带签名载荷”仅部分老旧 S3 需要，默认不勾"
                                   FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="保存 S3 凭证并切换" Padding="20,6" Margin="0,0,8,0"
                                    Command="{Binding SaveS3Command}"
                                    FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}"/>
                            <Button Content="清除凭证" Padding="20,6"
                                    Command="{Binding SignOutCommand}" CommandParameter="s3"
                                    Visibility="{Binding IsProviderSignedIn, Converter={StaticResource BoolToVisibilityConverter}}"
                                    FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
                                <Button.Foreground>
                                    <SolidColorBrush Color="#E74856"/>
                                </Button.Foreground>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

            <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                </Border.Background>
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding RedirectedGames.Count, StringFormat=已重定向游戏（共 {0} 个）}"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSortOption}"
                                      Padding="8,4" MinWidth="110" Margin="0,0,8,0" VerticalAlignment="Center"
                                      FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
                                <ComboBox.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </ComboBox.Background>
                            </ComboBox>
                            <Button Content="刷新" Padding="12,6"
                                    Command="{Binding RefreshCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}"
                                    FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
                                <Button.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ListStatusText}"
                                FontSize="12" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsListHintVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <controls:SmoothScrollViewer MaxHeight="420" Padding="0,0,12,0"
                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                   PreviewMouseWheel="GamesScrollViewer_PreviewMouseWheel"
                                   Visibility="{Binding RedirectedGames.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding RedirectedGames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="12" Margin="0,0,0,8"
                                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="120" Height="52"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                            <Border.Clip>
                                                <RectangleGeometry Rect="0,0,120,52" RadiusX="6" RadiusY="6"/>
                                            </Border.Clip>
                                            <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding GameName}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding SaveSubtitle}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="打开路径" Padding="12,6"
                                                    Command="{Binding DataContext.OpenSaveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding AppId}"
                                                    FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
                                                <Button.Background>
                                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                                </Button.Background>
                                            </Button>
                                            <Button Content="删除存档" Padding="12,6" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.DeleteGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    FocusVisualStyle="{StaticResource GamepadFocusVisualStyle}">
                                                <Button.Background>
                                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                                </Button.Background>
                                                <Button.Foreground>
                                                    <SolidColorBrush Color="#E74856"/>
                                                </Button.Foreground>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </controls:SmoothScrollViewer>
                </StackPanel>
            </Border>

        </StackPanel>
    </controls:SmoothScrollViewer>
</UserControl>
