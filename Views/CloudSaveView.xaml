<UserControl xmlns:controls="clr-namespace:SteamLuaManager.Controls" x:Class="SteamLuaManager.Views.CloudSaveView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SteamLuaManager.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- 折叠按钮：展开时显示向上箭头，折叠后显示向下箭头，悬停有轻量背景 -->
        <Style x:Key="ProviderCollapseIconStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="IconHost" Background="{TemplateBinding Background}" CornerRadius="6">
                            <Grid Width="10" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 0 0 L 4 4 L 8 0"
                                      Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                      StrokeThickness="1.6" Width="10" Height="8" Stretch="Uniform"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="ChevronRotate" Angle="180"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="180" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconHost" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconHost" Property="Background"
                                        Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 配置卡片：右上角图标控制展开，内容沿 Y 轴向上收缩；默认展开 -->
        <Style x:Key="ProviderCardExpanderStyle" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                            </Border.Background>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" ContentSource="Header"
                                                      VerticalAlignment="Center"/>
                                    <ToggleButton Grid.Column="1" x:Name="HeaderToggle"
                                                  Margin="8,0,0,0"
                                                  Style="{StaticResource ProviderCollapseIconStyle}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                </Grid>
                                <Grid x:Name="ContentGrid" Margin="0,10,0,0">
                                    <Grid.LayoutTransform>
                                        <ScaleTransform x:Name="ContentScale" ScaleY="1"/>
                                    </Grid.LayoutTransform>
                                    <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Opacity="1"
                                                      RenderTransformOrigin="0.5,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="CollapseBS">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ExpandSite"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                    <StopStoryboard BeginStoryboardName="ExpandBS"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard x:Name="ExpandBS">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ExpandSite"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                    <StopStoryboard BeginStoryboardName="CollapseBS"/>
                                </Trigger.ExitActions>
                                <!-- 折叠后禁用内容，避免零高度状态下仍被 Tab 聚焦 -->
                                <Setter TargetName="ContentGrid" Property="IsEnabled" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,24,36,24">

            <TextBlock Text="{l:Loc Cloud_Title}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="{l:Loc Cloud_Desc1}"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{l:Loc Cloud_Desc2}"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{l:Loc Cloud_Desc3}"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <ui:SettingsCard Header="{l:Loc Cloud_Header}" Margin="0,0,0,8"
                             Description="{l:Loc Cloud_HeaderDesc}"
                             Style="{StaticResource SettingsCardStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{l:Loc Cloud_TestConn}" Command="{Binding TestConnectionCommand}"
                                Padding="12,4" Margin="0,0,8,0" VerticalAlignment="Center"
                                Visibility="{Binding IsCloudProvider, Converter={StaticResource BoolToVisibilityConverter}}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}">
                            <Button.Background>
                                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                            </Button.Background>
                        </Button>
                        <ComboBox ItemsSource="{Binding CloudProviders}"
                                  SelectedItem="{Binding SelectedProviderOption}"
                                  DisplayMemberPath="DisplayName"
                                  Padding="8,4" MinWidth="140" Margin="0,0,12,0" VerticalAlignment="Center">
                        <ComboBox.Background>
                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                        </ComboBox.Background>
                    </ComboBox>
                    <ui:ToggleSwitch IsOn="{Binding IsCloudEnabled, Mode=TwoWay}"
                                     IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}"
                                     OnContent="{l:Loc Common_On}" OffContent="{l:Loc Common_Off}" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:SettingsCard>
            <TextBlock Text="{Binding ProviderStatusLine}" FontSize="12" Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding ProviderStatusLine, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

            <ui:SettingsCard Header="{l:Loc Cloud_LocalDir}" Margin="0,0,0,8"
                                     Description="{l:Loc Cloud_LocalDirDesc}"
                                     Style="{StaticResource SettingsCardStyle}"
                                     Visibility="{Binding SelectedProvider, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=folder}">
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding SyncPathText, Mode=OneWay}"
                             ToolTip="{Binding SyncPathText}"
                             IsReadOnly="True" Width="240" Padding="8,6" Margin="0,0,4,0">
                        <TextBox.Background>
                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                        </TextBox.Background>
                    </TextBox>
                    <Button Content="{l:Loc Common_Custom}" Command="{Binding BrowseSyncPathCommand}"
                            Padding="12,6" Margin="4,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}">
                        <Button.Background>
                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                        </Button.Background>
                    </Button>
                    <Button Content="{l:Loc Common_Reset}" Command="{Binding ResetSyncPathCommand}"
                            Padding="12,6" Margin="4,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}">
                        <Button.Background>
                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </ui:SettingsCard>

                <!-- OAuth 登录面板：Google Drive / OneDrive -->
                <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{Binding SelectedProvider, Converter={StaticResource OAuthProviderVisibilityConverter}, ConverterParameter=gdrive|onedrive}">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                    </Border.Background>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="{l:Loc Cloud_SignIn}" Padding="20,6" Margin="0,0,8,0"
                                        Command="{Binding SignInCommand}"
                                        Visibility="{Binding IsProviderSignedIn, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                        IsEnabled="{Binding IsSigningIn, Converter={StaticResource BoolInvertConverter}}"/>
                                <Button Content="{l:Loc Cloud_SwitchAccount}" Padding="20,6" Margin="0,0,8,0"
                                        Command="{Binding SignInCommand}"
                                        Visibility="{Binding IsProviderSignedIn, Converter={StaticResource BoolToVisibilityConverter}}"
                                        IsEnabled="{Binding IsSigningIn, Converter={StaticResource BoolInvertConverter}}"/>
                                <Button Content="{l:Loc Cloud_SignOut}" Padding="20,6" Margin="0,0,8,0"
                                        Command="{Binding SignOutCommand}"
                                        Visibility="{Binding IsProviderSignedIn, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button.Foreground>
                                        <SolidColorBrush Color="#E74856"/>
                                    </Button.Foreground>
                                </Button>
                                <Button Content="{l:Loc Common_Cancel}" Padding="20,6"
                                        Command="{Binding CancelSignInCommand}"
                                        IsEnabled="{Binding IsSigningIn}"/>
                            </StackPanel>
                            <Button Content="{l:Loc Cloud_Clear}" Padding="20,6" HorizontalAlignment="Right"
                                    Command="{Binding ClearAuthLogCommand}"
                                    IsEnabled="{Binding IsSigningIn, Converter={StaticResource BoolInvertConverter}}"/>
                        </Grid>
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding AuthLogLines.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding AuthLogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas,微软雅黑" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,1"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- R2 凭证表单 -->
                <Expander Style="{StaticResource ProviderCardExpanderStyle}"
                          IsExpanded="{Binding IsR2ConfigExpanded, Mode=TwoWay}"
                          Visibility="{Binding SelectedProvider, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=r2}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cloudflare R2" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{l:Loc Cloud_ConfigSection}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Account ID *" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding R2AccountId, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Access Key ID *" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding R2AccessKeyId, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Secret Key *" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="R2SecretBox" Padding="8,6" Margin="0,4"
                                         PasswordChanged="R2SecretBox_PasswordChanged"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Bucket *" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding R2Bucket, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Key Prefix" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding R2KeyPrefix, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Endpoint" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding R2Endpoint, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"/>
                        </Grid>
                        <TextBlock Text="{l:Loc Cloud_R2Hint}"
                                   FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{l:Loc Cloud_SaveR2}" Padding="20,6" Margin="0,0,8,0"
                                    Command="{Binding SaveR2Command}"/>
                            <Button Content="{l:Loc Cloud_ClearCred}" Padding="20,6"
                                    Command="{Binding SignOutCommand}" CommandParameter="r2"
                                    Visibility="{Binding IsProviderSignedIn, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Foreground>
                                    <SolidColorBrush Color="#E74856"/>
                                </Button.Foreground>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- S3 凭证表单 -->
                <Expander Style="{StaticResource ProviderCardExpanderStyle}"
                          IsExpanded="{Binding IsS3ConfigExpanded, Mode=TwoWay}"
                          Visibility="{Binding SelectedProvider, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=s3}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:Loc Cloud_ProviderS3}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{l:Loc Cloud_ConfigSection}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Access Key ID *" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding S3AccessKeyId, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Secret Key *" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="S3SecretBox" Padding="8,6" Margin="0,4"
                                         PasswordChanged="S3SecretBox_PasswordChanged"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Bucket *" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding S3Bucket, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Endpoint *" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding S3Endpoint, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Region *" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding S3Region, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Key Prefix" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding S3KeyPrefix, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{l:Loc Cloud_CaCert}" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <TextBox Text="{Binding S3CaCertPath}" IsReadOnly="True" Width="220" Padding="8,6" Margin="0,0,8,0"/>
                                <Button Content="{l:Loc Cloud_Browse}" Padding="12,6" Command="{Binding BrowseCaCertCommand}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <CheckBox Content="{l:Loc Cloud_SignPayload}" IsChecked="{Binding S3SignPayload}" Margin="0,0,16,0"/>
                                <CheckBox Content="{l:Loc Cloud_AllowHttp}" IsChecked="{Binding S3AllowInsecureHttp}" Margin="0,0,16,0"/>
                                <CheckBox Content="{l:Loc Cloud_SkipTls}" IsChecked="{Binding S3AllowInsecureTls}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{l:Loc Cloud_S3Hint}"
                                   FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{l:Loc Cloud_SaveS3}" Padding="20,6" Margin="0,0,8,0"
                                    Command="{Binding SaveS3Command}"/>
                            <Button Content="{l:Loc Cloud_ClearCred}" Padding="20,6"
                                    Command="{Binding SignOutCommand}" CommandParameter="s3"
                                    Visibility="{Binding IsProviderSignedIn, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Foreground>
                                    <SolidColorBrush Color="#E74856"/>
                                </Button.Foreground>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- WebDAV 凭证表单 -->
                <Expander Style="{StaticResource ProviderCardExpanderStyle}"
                          IsExpanded="{Binding IsWebDavConfigExpanded, Mode=TwoWay}"
                          Visibility="{Binding SelectedProvider, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=webdav}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WebDAV" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{l:Loc Cloud_ConfigSection}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="URL *" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding WebDavUrl, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Loc Cloud_WebDavUser}" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WebDavUsername, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Loc Cloud_WebDavPassword}" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="WebDavPasswordBox" Padding="8,6" Margin="0,4"
                                         PasswordChanged="WebDavPasswordBox_PasswordChanged"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{l:Loc Cloud_WebDavAuth}" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding WebDavAuthOptions}"
                                      SelectedItem="{Binding SelectedWebDavAuth}" DisplayMemberPath="Display"
                                      Padding="8,6" Margin="0,4" HorizontalAlignment="Left" MinWidth="200"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{l:Loc Cloud_WebDavToken}" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding WebDavBearerToken, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{l:Loc Cloud_WebDavPrefix}" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding WebDavKeyPrefix, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{l:Loc Cloud_WebDavTimeout}" VerticalAlignment="Center" FontSize="12" Margin="0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding WebDavTimeout, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4" HorizontalAlignment="Left" Width="100"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="{l:Loc Cloud_WebDavHeaders}" VerticalAlignment="Top" FontSize="12" Margin="0,8,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding WebDavExtraHeaders, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" Margin="0,4" Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <CheckBox Content="{l:Loc Cloud_AllowHttp}" IsChecked="{Binding WebDavAllowInsecureHttp}" Margin="0,0,16,0"/>
                                <CheckBox Content="{l:Loc Cloud_SkipTls}" IsChecked="{Binding WebDavAllowInsecureTls}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{l:Loc Cloud_WebDavHint}"
                                   FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{l:Loc Cloud_SaveWebDav}" Padding="20,6" Margin="0,0,8,0"
                                    Command="{Binding SaveWebDavCommand}"/>
                            <Button Content="{l:Loc Cloud_ClearCred}" Padding="20,6"
                                    Command="{Binding SignOutCommand}" CommandParameter="webdav"
                                    Visibility="{Binding IsProviderSignedIn, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Foreground>
                                    <SolidColorBrush Color="#E74856"/>
                                </Button.Foreground>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Expander>

            <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                </Border.Background>
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding RedirectedGamesTitle}"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSortOptionItem}"
                                      DisplayMemberPath="Display"
                                      Padding="8,4" MinWidth="110" Margin="0,0,8,0" VerticalAlignment="Center">
                                <ComboBox.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </ComboBox.Background>
                            </ComboBox>
                            <Button Content="{l:Loc Cloud_Refresh}" Padding="12,6"
                                    Command="{Binding RefreshCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}">
                                <Button.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ListStatusText}"
                                FontSize="12" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsListHintVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <controls:SmoothScrollViewer MaxHeight="420" Padding="0,0,12,0"
                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                   PreviewMouseWheel="GamesScrollViewer_PreviewMouseWheel"
                                   Visibility="{Binding RedirectedGames.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding RedirectedGames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="12" Margin="0,0,0,8"
                                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="120" Height="52"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                            <Border.Clip>
                                                <RectangleGeometry Rect="0,0,120,52" RadiusX="6" RadiusY="6"/>
                                            </Border.Clip>
                                            <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding GameName}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding SaveSubtitle}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{l:Loc Cloud_OpenPath}" Padding="12,6"
                                                    Command="{Binding DataContext.OpenSaveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding AppId}">
                                                <Button.Background>
                                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                                </Button.Background>
                                            </Button>
                                            <Button Content="{l:Loc Cloud_DeleteSave}" Padding="12,6" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.DeleteGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Background>
                                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                                </Button.Background>
                                                <Button.Foreground>
                                                    <SolidColorBrush Color="#E74856"/>
                                                </Button.Foreground>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </controls:SmoothScrollViewer>
                </StackPanel>
            </Border>

        </StackPanel>
    </controls:SmoothScrollViewer>
</UserControl>
