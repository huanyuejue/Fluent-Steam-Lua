<UserControl xmlns:controls="clr-namespace:SteamLuaManager.Controls" x:Class="SteamLuaManager.Views.AuthorizationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SteamLuaManager.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        AllowDrop="True"
        DragEnter="Zone_DragEnter"
        DragOver="Zone_DragOver"
        Drop="Zone_Drop"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="AuthCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResultBoxStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{l:Loc Auth_Title}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" LineHeight="20"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="{l:Loc Auth_Desc1}"/><LineBreak/>
                <Run Text="{l:Loc Auth_Desc2}"/><LineBreak/>
                <Run Text="{l:Loc Auth_Desc3}"/>
            </TextBlock>
        </StackPanel>

        <!-- 内容区 -->
        <controls:SmoothScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== 卡片一：提取授权 ===== -->
                <Border Grid.Column="0" Style="{StaticResource AuthCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="8" VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <ui:FontIcon Glyph="&#xE896;" FontSize="16" HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Auth_ExtractTitle}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{l:Loc Auth_ExtractDesc}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="ExtractAppIdBox"
                                         ToolTip="{l:Loc Auth_AppIdTip}"
                                         Text="{Binding ExtractAppIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36" VerticalContentAlignment="Center"
                                         Padding="10,0"
                                         KeyDown="ExtractAppIdBox_KeyDown"
                                         IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}">
                                    <TextBox.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </TextBox.Background>
                                </TextBox>
                                <TextBlock Text="{l:Loc Auth_AppIdWatermark}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=ExtractAppIdBox}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="1" Margin="10,0,0,0" Height="36" Padding="18,0"
                                    Content="{Binding IsExtracting, Converter={StaticResource BoolToRunStopConverter}}"
                                    Command="{Binding ExtractCommand}"
                                    IsEnabled="{Binding IsImporting, Converter={StaticResource BoolInvertConverter}}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8"
                              Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:ProgressRing IsActive="True" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="12" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Text="{l:Loc Auth_Extracting}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>

                        <!-- 提取结果 -->
                        <Border Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ResultBoxStyle}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastExtractSummary}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding LastExtractSummary}" FontSize="12" LineHeight="20"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastExtractPath}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Content="{l:Loc Auth_CopyPath}" Height="36" Padding="18,0"
                                            Command="{Binding CopyExtractPathCommand}"/>
                                    <Button Content="{l:Loc Common_OpenDir}" Height="36" Padding="18,0" Margin="8,0,0,0"
                                            Command="{Binding OpenExtractFolderCommand}"/>
                                </StackPanel>
                                <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" LineHeight="20"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{l:Loc Auth_ExtractSavedNote}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== 卡片二：导入授权 ===== -->
                <Border Grid.Column="2" Style="{StaticResource AuthCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="8" VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <ui:FontIcon Glyph="&#xE8B5;" FontSize="16" HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Auth_ImportTitle}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{l:Loc Auth_ImportDesc}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 拖放区（虚线框） -->
                        <Grid Height="120" Cursor="Hand" Background="Transparent"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource BoolInvertConverter}}"
                              MouseLeftButtonDown="DropZone_MouseLeftButtonDown">
                            <Rectangle RadiusX="10" RadiusY="10" Fill="Transparent"
                                       StrokeDashArray="4,3">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Stroke" Value="{DynamicResource SystemAccentColorBrush}"/>
                                        <Setter Property="StrokeThickness" Value="1.5"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource SystemAccentColorSecondaryBrush}"/>
                                                <Setter Property="StrokeThickness" Value="2.5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:FontIcon Glyph="&#xE896;" FontSize="30" HorizontalAlignment="Center"
                                             Foreground="{DynamicResource SystemAccentColorBrush}"/>
                                <TextBlock Text="{l:Loc Auth_DropTitle}" FontSize="14" Margin="0,10,0,0"
                                           HorizontalAlignment="Center" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{l:Loc Auth_DropHint}" FontSize="11" Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0"
                              Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:ProgressRing IsActive="True" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="12" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Text="{l:Loc Auth_Importing}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>

                        <!-- 导入结果 -->
                        <Border Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ResultBoxStyle}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastImportSummary}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding LastImportSummary}" FontSize="12" LineHeight="20"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" LineHeight="20"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{l:Loc Auth_ImportValidNote}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20"
                                   TextAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <Run Text="{l:Loc Auth_FootNote1}"/><LineBreak/>
                            <Run Text="{l:Loc Auth_FootNote2}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </controls:SmoothScrollViewer>

        <!-- 状态条 -->
        <ui:InfoBar Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource InfoBarStyle}"
                    IsOpen="{Binding StatusOpen, Mode=TwoWay}"
                    Severity="{Binding StatusSeverity}"
                    Title="{Binding StatusTitle}"
                    Message="{Binding StatusMessage}"
                    HorizontalAlignment="Left"/>
    </Grid>
</UserControl>