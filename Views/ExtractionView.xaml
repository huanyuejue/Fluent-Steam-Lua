<UserControl xmlns:controls="clr-namespace:SteamLuaManager.Controls" x:Class="SteamLuaManager.Views.ExtractionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SteamLuaManager.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,24,36,24">

            <TextBlock Text="{l:Loc Extract_Title}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="{l:Loc Extract_Desc1}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{l:Loc Extract_Desc2}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- AppID 输入 + 选项 -->
            <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                </Border.Background>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" VerticalAlignment="Stretch">
                            <TextBlock Text="{l:Loc Extract_AppIdWatermark}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=AppIdBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="AppIdBox"
                                     Text="{Binding AppId, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" Height="36" FontSize="14"
                                     VerticalContentAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     Background="Transparent"
                                     IsEnabled="{Binding IsRunning, Converter={StaticResource BoolInvertConverter}}"/>
                        </Grid>

                        <Button Grid.Column="1" Command="{Binding StartExtractionCommand}"
                                Padding="16,6" Height="36" Margin="8,0,4,0">
                            <Button.Background>
                                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:FontIcon Glyph="&#xE768;" FontSize="14" Margin="0,0,6,0"
                                             Visibility="{Binding IsRunning, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                                <ui:FontIcon Glyph="&#xE71A;" FontSize="14" Margin="0,0,6,0"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding IsRunning, Converter={StaticResource BoolToRunStopConverter}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Command="{Binding ClearLogCommand}"
                                Padding="16,6" Height="36" Margin="4,0,0,0">
                            <Button.Background>
                                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE74D;" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{l:Loc Common_ClearLog}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LoginStatusText}" FontSize="13" Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Button Content="{l:Loc Extract_Login}" Command="{Binding OpenLoginCommand}"
                                Padding="16,6" Height="32" FontSize="13" Margin="0,0,8,0"
                                Visibility="{Binding IsLoggedOn, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                        <Button Content="{l:Loc Extract_SwitchAccount}" Command="{Binding OpenLoginCommand}"
                                Padding="16,6" Height="32" FontSize="13" Margin="0,0,8,0"
                                Visibility="{Binding IsLoggedOn, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="{l:Loc Common_Logout}" Command="{Binding LogoutCommand}"
                                Padding="16,6" Height="32" FontSize="13"
                                Visibility="{Binding IsLoggedOn, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox Content="{l:Loc Extract_Pin}" IsChecked="{Binding PinManifest}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  FontSize="13" Margin="0,0,32,0"
                                  ToolTip="{l:Loc Extract_PinTip}"/>
                        <CheckBox Content="{l:Loc Extract_Ach}" IsChecked="{Binding ExtractAchievements}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  FontSize="13" Margin="0,0,32,0"
                                  ToolTip="{l:Loc Extract_AchTip}"/>
                        <CheckBox Content="{l:Loc Extract_ManifestDl}" IsChecked="{Binding DownloadManifests}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  FontSize="13"
                                  ToolTip="{l:Loc Extract_ManifestDlTip}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 日志区域 -->
            <Border CornerRadius="10" Padding="0"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,8">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                </Border.Background>
                <Grid>
                    <TextBlock Text="{l:Loc Common_NoLog}" Style="{StaticResource LogEmptyStyle}"
                               Visibility="{Binding LogLines.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Disabled" Margin="16,16,16,16"
                                  PreviewMouseWheel="LogScrollViewer_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource LogTextStyle}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button x:Name="CopyLogButton" Content="{l:Loc Common_CopyLog}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,8,0" Padding="8,4" FontSize="12"
                            Click="CopyLogButton_Click" Visibility="Collapsed">
                        <Button.Background>
                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                        </Button.Background>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </controls:SmoothScrollViewer>
</UserControl>
