<UserControl xmlns:controls="clr-namespace:SteamLuaManager.Controls" x:Class="SteamLuaManager.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SteamLuaManager.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{l:Loc Settings_Title}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                    SelectionChanged="TabControl_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Padding" Value="16,6"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="0"
                                        CornerRadius="6">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="False"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      TextElement.FontSize="{TemplateBinding FontSize}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" IsItemsHost="True"
                                    Orientation="Horizontal"
                                    Background="Transparent"/>
                        <ContentPresenter x:Name="ContentArea" Grid.Row="1"
                                          ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- 基本设置 -->
            <TabItem Header="{l:Loc Settings_TabBasic}">
                <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0"
                              Background="Transparent" Padding="0,0,20,0">
                    <StackPanel Margin="0,8,0,16">

                        <ui:SettingsCard Header="{l:Loc Settings_SteamPath}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_SteamPathDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding SteamPath, Mode=OneWay}"
                                         IsReadOnly="True" Width="240" Padding="8,6" Margin="0,0,4,0">
                                    <TextBox.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </TextBox.Background>
                                </TextBox>
                                <Button Content="{l:Loc Common_Custom}" Command="{Binding BrowseSteamPathCommand}"
                                        Padding="12,6" Margin="4,0">
                                    <Button.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </Button.Background>
                                </Button>
                                <Button Content="{l:Loc Common_Reset}" Command="{Binding ResetSteamPathCommand}"
                                        Padding="12,6" Margin="4,0">
                                    <Button.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_LuaPath}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_LuaPathDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding LuaFolderPath, Mode=OneWay}"
                                         IsReadOnly="True" Width="240" Padding="8,6" Margin="0,0,4,0">
                                    <TextBox.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </TextBox.Background>
                                </TextBox>
                                <Button Content="{l:Loc Common_Custom}" Command="{Binding ChangeLuaFolderCommand}"
                                        Padding="12,6" Margin="4,0">
                                    <Button.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </Button.Background>
                                </Button>
                                <Button Content="{l:Loc Common_Reset}" Command="{Binding ResetLuaConfigCommand}"
                                        Padding="12,6" Margin="4,0">
                                    <Button.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_AutoUpdate}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_AutoUpdateDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <ui:ToggleSwitch IsOn="{Binding AutoCheckUpdateEnabled}"
                                             OnContent="{l:Loc Common_On}" OffContent="{l:Loc Common_Off}"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_MinTray}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_MinTrayDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <ui:ToggleSwitch IsOn="{Binding MinimizeToTray}"
                                             OnContent="{l:Loc Common_On}" OffContent="{l:Loc Common_Off}"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_BinStats}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_BinStatsDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <Button Content="{l:Loc Common_OpenDir}" Command="{Binding OpenBinStatsFolderCommand}"
                                    Padding="12,6" Margin="4,0">
                                <Button.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </Button.Background>
                            </Button>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_ManifestFolder}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_ManifestFolderDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <Button Content="{l:Loc Common_OpenDir}" Command="{Binding OpenManifestFolderCommand}"
                                    Padding="12,6" Margin="4,0">
                                <Button.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </Button.Background>
                            </Button>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_SteamFolder}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_SteamFolderDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <Button Content="{l:Loc Common_OpenDir}" Command="{Binding OpenSteamFolderCommand}"
                                    Padding="12,6" Margin="4,0">
                                <Button.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </Button.Background>
                            </Button>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_CacheMgmt}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_CacheMgmtDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{l:Loc Common_ClearCache}" Command="{Binding ClearCacheCommand}"
                                        Padding="12,6" Margin="4,0">
                                    <Button.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </Button.Background>
                                </Button>
                                <Button Content="{l:Loc Common_OpenCacheDir}" Command="{Binding OpenCacheFolderCommand}"
                                        Padding="12,6" Margin="4,0">
                                    <Button.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                        </ui:SettingsCard>

                    </StackPanel>
                </controls:SmoothScrollViewer>
            </TabItem>

            <!-- 显示设置 -->
            <TabItem Header="{l:Loc Settings_TabDisplay}">
                <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0"
                              Background="Transparent" Padding="0,0,20,0">
                    <StackPanel Margin="0,8,0,16">

                        <ui:SettingsCard Header="{l:Loc Settings_Theme}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_ThemeDesc}"
Style="{StaticResource SettingsCardStyle}">
                              <ComboBox ItemsSource="{Binding ThemeOptions}"
                                       SelectedItem="{Binding SelectedThemeOption}"
                                       DisplayMemberPath="Display"
                                       HorizontalAlignment="Left" Padding="8,4">
                                <ComboBox.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </ComboBox.Background>
                              </ComboBox>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_Backdrop}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_BackdropDesc}"
Style="{StaticResource SettingsCardStyle}">
                              <ComboBox ItemsSource="{Binding BackdropOptions}"
                                       SelectedItem="{Binding SelectedBackdropOption}"
                                       DisplayMemberPath="Display"
                                       HorizontalAlignment="Left" Padding="8,4">
                                <ComboBox.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </ComboBox.Background>
                              </ComboBox>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_Language}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_LanguageDesc}"
Style="{StaticResource SettingsCardStyle}">
                              <ComboBox ItemsSource="{Binding LanguageOptions}"
                                       SelectedValue="{Binding Language}"
                                       SelectedValuePath="Code" DisplayMemberPath="Display"
                                       HorizontalAlignment="Left" Padding="8,4">
                                <ComboBox.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </ComboBox.Background>
                              </ComboBox>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_Fab}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_FabDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <ui:ToggleSwitch IsOn="{Binding IsFabVisible}"
                                             OnContent="{l:Loc Common_On}" OffContent="{l:Loc Common_Off}"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_CardRefresh}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_CardRefreshDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <ui:ToggleSwitch IsOn="{Binding IsCardRefreshVisible}"
                                             OnContent="{l:Loc Common_On}" OffContent="{l:Loc Common_Off}"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_AutoCovers}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_AutoCoversDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <ui:ToggleSwitch IsOn="{Binding AutoFetchCovers}"
                                             OnContent="{l:Loc Common_On}" OffContent="{l:Loc Common_Off}"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_Ranking}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_RankingDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <ui:ToggleSwitch IsOn="{Binding ShowRanking}"
                                             OnContent="{l:Loc Common_On}" OffContent="{l:Loc Common_Off}"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_TrainerSection}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_TrainerSectionDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <ui:ToggleSwitch IsOn="{Binding IsShowTrainerSections}"
                                             OnContent="{l:Loc Common_On}" OffContent="{l:Loc Common_Off}"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_CopyLog}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_CopyLogDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <ui:ToggleSwitch IsOn="{Binding IsShowCopyLogButton}"
                                             OnContent="{l:Loc Common_On}" OffContent="{l:Loc Common_Off}"/>
                        </ui:SettingsCard>

                    </StackPanel>
                </controls:SmoothScrollViewer>
            </TabItem>

            <!-- 接口设置 -->
            <TabItem Header="{l:Loc Settings_TabApi}">
                <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0"
                              Background="Transparent" Padding="0,0,20,0">
                    <StackPanel Margin="0,8,0,16">

                        <ui:SettingsCard Header="{l:Loc Settings_DownloadMode}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_DownloadModeDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <ComboBox SelectedValue="{Binding DownloadMode, Mode=TwoWay}"
                                       SelectedValuePath="Tag" HorizontalAlignment="Left" Padding="8,4">
                                <ComboBox.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </ComboBox.Background>
                                <ComboBoxItem Content="{l:Loc Settings_LocalCache}" Tag="DepotKey"/>
                                <ComboBoxItem Content="{l:Loc Settings_RemoteRepo}" Tag="Remote"/>
                            </ComboBox>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_Mirror}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_MirrorDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{l:Loc Common_SpeedTest}" Command="{Binding TestMirrorSpeedCommand}"
                                            IsEnabled="{Binding IsMirrorSpeedTesting, Converter={StaticResource BoolInvertConverter}}"
                                            Padding="12,6" Margin="0,0,4,0">
                                        <Button.Background>
                                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                        </Button.Background>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsMirrorSpeedTesting, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ProgressBar Value="{Binding MirrorSpeedTestProgress}"
                                                     Maximum="{Binding MirrorSpeedTestTotal}"
                                                     Width="100" Height="3" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding MirrorSpeedTestProgressText}" FontSize="12"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ComboBox SelectedValue="{Binding ManifestMirror, Mode=TwoWay}"
                                               SelectedValuePath="Tag" HorizontalAlignment="Left" Padding="8,4">
                                        <ComboBox.Background>
                                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                        </ComboBox.Background>
                                        <ComboBoxItem Content="{l:Loc Common_DirectDefault}" Tag="direct"/>
                                        <ComboBoxItem Content="gh-proxy.com" Tag="gh-proxy.com"/>
                                        <ComboBoxItem Content="ghfast.top" Tag="ghfast.top"/>
                                        <ComboBoxItem Content="gh-proxy.org" Tag="gh-proxy.org"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </ui:SettingsCard>

                        <Border CornerRadius="8" Background="{DynamicResource LayerFillColorDefaultBrush}"
                                Margin="0,0,0,8" Padding="12,8"
                                Visibility="{Binding MirrorSpeedTestResults.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding MirrorSpeedTestResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding ColorCode}"
                                                     Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.9"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <ui:SettingsCard Header="{l:Loc Settings_Cdn}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_CdnDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{l:Loc Common_SpeedTest}" Command="{Binding TestCdnSpeedCommand}"
                                            IsEnabled="{Binding IsSpeedTesting, Converter={StaticResource BoolInvertConverter}}"
                                            Padding="12,6" Margin="0,0,4,0">
                                        <Button.Background>
                                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                        </Button.Background>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsSpeedTesting, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ProgressBar Value="{Binding SpeedTestProgress}"
                                                     Maximum="{Binding SpeedTestTotal}"
                                                     Width="100" Height="3" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SpeedTestProgressText}" FontSize="12"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                     <ComboBox ItemsSource="{Binding CdnDisplayOptions}"
                                                SelectedItem="{Binding SelectedCdnOption}"
                                                DisplayMemberPath="Display"
                                                  HorizontalAlignment="Left" Padding="8,4">
                                        <ComboBox.Background>
                                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                        </ComboBox.Background>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </ui:SettingsCard>

                        <Border CornerRadius="8" Background="{DynamicResource LayerFillColorDefaultBrush}"
                                Margin="0,0,0,8" Padding="12,8"
                                Visibility="{Binding SpeedTestResults.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding SpeedTestResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding ColorCode}"
                                                     Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.9"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <ui:SettingsCard Header="{l:Loc Settings_KeyCache}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_KeyCacheDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <ui:ToggleSwitch IsOn="{Binding AutoRefreshKeyCache}"
                                             OnContent="{l:Loc Common_On}" OffContent="{l:Loc Common_Off}"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_Logging}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_LoggingDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <ui:ToggleSwitch IsOn="{Binding EnableLogging}"
                                             OnContent="{l:Loc Common_On}" OffContent="{l:Loc Common_Off}"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_AutoRefresh}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_AutoRefreshDesc}"
Style="{StaticResource SettingsCardStyle}">
                            <ui:ToggleSwitch IsOn="{Binding IsAutoRefreshEnabled}"
                                             OnContent="{l:Loc Common_On}" OffContent="{l:Loc Common_Off}"/>
                        </ui:SettingsCard>

                    </StackPanel>
                </controls:SmoothScrollViewer>
            </TabItem>

            <!-- 内核设置 -->
            <TabItem Header="{l:Loc Settings_TabKernel}">
                <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0"
                              Background="Transparent" Padding="0,0,20,0">
                    <StackPanel Margin="0,8,0,16">

                        <ui:InfoBar Style="{StaticResource InfoBarStyle}"
                                    IsOpen="True"
                                    Severity="Warning"
                                    IsClosable="False"
                                    Margin="0,0,0,8"
                                                                         Message="{l:Loc Settings_KernelWarn}"/>

                        <ui:SettingsCard Header="{l:Loc Settings_ManifestSource}" Margin="0,0,0,8"
                                           Description="{l:Loc Settings_ManifestSourceDesc}"
                                          Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{l:Loc Common_ConnTest}" Padding="12,6" Margin="0,0,4,0"
                                        Command="{Binding TestManifestSourceCommand}"
                                        IsEnabled="{Binding IsManifestSourceTesting, Converter={StaticResource BoolInvertConverter}}">
                                    <Button.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </Button.Background>
                                </Button>
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsManifestSourceTesting, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ProgressBar Value="{Binding ManifestTestProgress}"
                                                 Maximum="{Binding ManifestTestTotal}"
                                                 Width="100" Height="3" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ManifestTestProgressText}" FontSize="12"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding ManifestSourceOptions}"
                                          SelectedValue="{Binding SelectedManifestSource}"
                                          SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                          HorizontalAlignment="Left" Padding="8,4" MinWidth="140">
                                    <ComboBox.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </ComboBox.Background>
                                </ComboBox>
                            </StackPanel>
                        </ui:SettingsCard>

                        <!-- 连通测试结果 -->
                        <Border CornerRadius="8" Background="{DynamicResource LayerFillColorDefaultBrush}"
                                Margin="0,0,0,8" Padding="12,8"
                                Visibility="{Binding ManifestTestResults.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding ManifestTestResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding ColorCode}"
                                                     Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.9"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <ui:SettingsCard Header="{l:Loc Settings_Failover}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_FailoverDesc}"
                                         Style="{StaticResource SettingsCardStyle}">
                            <ui:ToggleSwitch IsOn="{Binding ManifestFailoverEnabled}"
                                             IsEnabled="{Binding IsManifestFailoverAvailable}"
                                             OnContent="{l:Loc Common_On}" OffContent="{l:Loc Common_Off}"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_KernelUpdate}" Margin="0,0,0,8"
                                           Description="{l:Loc Settings_KernelUpdateDesc}"
                                          Style="{StaticResource SettingsCardStyle}">
                            <ui:ToggleSwitch IsOn="{Binding AutoCheckKernelUpdateEnabled}"
                                             OnContent="{l:Loc Common_On}" OffContent="{l:Loc Common_Off}"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="{l:Loc Settings_Broadcast}" Margin="0,0,0,8"
                                         Description="{l:Loc Settings_BroadcastDesc}"
                                          Style="{StaticResource SettingsCardStyle}">
                            <ui:ToggleSwitch IsOn="{Binding FriendBroadcastEnabled}"
                                             IsEnabled="{Binding IsFriendBroadcastAvailable}"
                                             OnContent="{l:Loc Common_On}" OffContent="{l:Loc Common_Off}"/>
                        </ui:SettingsCard>

                    </StackPanel>
                </controls:SmoothScrollViewer>
            </TabItem>

        </TabControl>

        <ui:InfoBar Grid.Row="2" Style="{StaticResource InfoBarStyle}"
                    IsOpen="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                    Message="{Binding StatusMessage}"
                    Severity="Informational"
                    IsClosable="False"
                    HorizontalAlignment="Left"
                    Margin="0,12,0,0"/>

    </Grid>
</UserControl>
