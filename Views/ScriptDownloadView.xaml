<UserControl xmlns:controls="clr-namespace:SteamLuaManager.Controls" x:Class="SteamLuaManager.Views.ScriptDownloadView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">


    <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,24,36,24" HorizontalAlignment="Stretch">

            <!-- 页面标题 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="游戏入库" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Margin="12,14,0,0" FontSize="12" FontWeight="Normal"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="-  当前清单接口 :"/>
                    <Run Text="{Binding CurrentDataSourceLabel, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
            <TextBlock Text="支持通过游戏AppID和游戏名搜索（中英文皆可），支持模糊匹配，最多显示10条搜索结果"
                       FontSize="12" Margin="0,0,0,2"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="如出现搜索不出结果可尝试开VPN或代理"
                       FontSize="12" Margin="0,0,0,2"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="如入库失败，可在设置-接口设置中切换入库接口后重试；刚发售的新游戏清单同步稍慢，可过一段时间再试"
                       FontSize="12" Margin="0,0,0,24"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <!-- 搜索卡片 -->
            <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:AutoSuggestBox x:Name="SearchBox" Grid.Column="0"
                                       PlaceholderText="输入游戏名或AppID"
                                       Padding="8,6" Margin="0,0,8,0" Height="36"
                                       VerticalContentAlignment="Center"
                                       FontSize="14" MinWidth="200"
                                       HorizontalAlignment="Stretch"
                                       QuerySubmitted="SearchBox_QuerySubmitted"
                                       TextChanged="SearchBox_TextChanged">
                        <ui:AutoSuggestBox.Background>
                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                        </ui:AutoSuggestBox.Background>
                        <ui:AutoSuggestBox.QueryIcon>
                            <ui:FontIcon Glyph="&#xE721;"/>
                        </ui:AutoSuggestBox.QueryIcon>
                    </ui:AutoSuggestBox>
                    <Button Grid.Column="1" Command="{Binding RefreshKeyCacheCommand}"
                            Padding="16,6" Height="36" FontSize="14" Margin="8,0,0,0"
                            Visibility="{Binding IsLocalCacheMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Background>
                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE72C;" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="更新密钥缓存" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding ClearLogCommand}"
                            Padding="16,6" Height="36" FontSize="14" Margin="8,0,0,0">
                        <Button.Background>
                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE74D;" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="清除日志" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 日志区域 -->
            <Border CornerRadius="10" Padding="0"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,8">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                </Border.Background>
                <Grid>
                    <TextBlock Text="暂无日志" Style="{StaticResource LogEmptyStyle}"
                               Visibility="{Binding LogLines.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Disabled" Margin="16,16,16,16"
                                  PreviewMouseWheel="LogScrollViewer_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource LogTextStyle}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button x:Name="CopyLogButton" Content="复制日志"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,8,0" Padding="8,4" FontSize="12"
                            Click="CopyLogButton_Click" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 搜索结果列表 -->
            <ItemsControl ItemsSource="{Binding SearchResults}" Margin="0,0,0,8"
                          Visibility="{Binding SearchResults.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="120" Height="52"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,120,52" RadiusX="6" RadiusY="6"/>
                                    </Border.Clip>
                                    <Image Source="{Binding CoverUrl}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="12" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="AppID: "/><Run Text="{Binding AppId}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Tag="{Binding}"
                                            Click="GameInfoButton_Click"
                                            Padding="16,6" Height="36" FontSize="14"
                                            Focusable="False" Margin="0,0,8,0">
                                        <Button.Background>
                                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                        </Button.Background>
                                        游戏信息
                                    </Button>
                                    <Button Command="{Binding DataContext.DownloadGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="16,6" Height="36" FontSize="14"
                                            Focusable="False"
                                            IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolInvertConverter}}">
                                        <Button.Background>
                                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                        </Button.Background>
                                        一键入库
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </controls:SmoothScrollViewer>
</UserControl>
