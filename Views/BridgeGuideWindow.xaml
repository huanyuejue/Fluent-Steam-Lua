<Window x:Class="SteamLuaManager.Views.BridgeGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SteamLuaManager.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:controls="clr-namespace:SteamLuaManager.Controls"
        Title="{l:Loc Bridge_WindowTitle}"
        Width="760" Height="900" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 状态分块底色：在卡片色基础上叠一层更深的半透明黑，深浅主题都能与卡片区分 -->
        <SolidColorBrush x:Key="StatusZoneFillBrush" Color="#1A000000"/>
    </Window.Resources>

    <!-- 用项目自研的平滑滚动接管滚轮，避免默认逐档跳变；覆盖式滚动条会浮在内容上方，靠 Padding 内缩避开 -->
    <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="28,22,34,26">
        <StackPanel>

            <!-- 标题卡 -->
            <Border CornerRadius="10" BorderThickness="1" Padding="24,20"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{l:Loc Bridge_HeaderTitle}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{l:Loc Bridge_HeaderDesc}" FontSize="14" Margin="0,10,0,0"
                               TextWrapping="Wrap" LineHeight="21"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 状态卡：顶部一行 + 下方两栏竖线分隔 -->
            <Border CornerRadius="10" BorderThickness="1" Margin="0,16,0,0" Padding="22,18"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="OverallDot" Grid.Column="0" Width="9" Height="9"
                                 Margin="0,0,11,0" VerticalAlignment="Center"
                                 Fill="#3DDC84"/>

                        <TextBlock Grid.Column="1" Text="{l:Loc Bridge_StatusTitle}" FontSize="17"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                        <Border x:Name="OverallStatePill" Grid.Column="2" Margin="14,0,0,0"
                                CornerRadius="5" Padding="11,3" VerticalAlignment="Center">
                            <TextBlock x:Name="OverallStateText" FontSize="12.5" FontWeight="SemiBold" Foreground="White"/>
                        </Border>

                        <TextBlock x:Name="VersionSummaryText" Grid.Column="3"
                                   FontSize="12" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,14,0"
                                   FontFamily="Consolas, Microsoft YaHei"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                        <Button x:Name="RefreshStatusButton" Grid.Column="4"
                                VerticalAlignment="Center" Padding="14,7,14,7" FontSize="13"
                                Click="RefreshStatus_Click"
                                ToolTip="{l:Loc Bridge_RefreshStatusTip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE72C;" FontSize="14" Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="{l:Loc Bridge_RefreshStatus}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 两个状态合并在同一块深色底内，中间用竖线分割；
                         底色比卡片深一档，靠半透明叠加实现，深浅主题都成立 -->
                    <Border Grid.Row="1" CornerRadius="8" Padding="16,13"
                            Background="{DynamicResource StatusZoneFillBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE7F4;" FontSize="18" Margin="0,0,12,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{l:Loc Bridge_BridgeTitle}" FontSize="14.5"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Border x:Name="BridgeStatePill" Margin="12,0,0,0"
                                            CornerRadius="12" Padding="11,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="BridgeStateText" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="BridgeProcessText" FontSize="12.5" Margin="30,7,0,0"
                                           FontFamily="Consolas, Microsoft YaHei"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Margin="18,2,18,2"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE8B7;" FontSize="18" Margin="0,0,12,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{l:Loc Bridge_ExtTitle}" FontSize="14.5"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Border x:Name="ExtStatePill" Margin="12,0,0,0"
                                            CornerRadius="12" Padding="11,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="ExtStateText" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="ExtDetailText" FontSize="12.5" Margin="30,7,0,0"
                                           FontFamily="Consolas, Microsoft YaHei"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 安装步骤：时间轴布局由代码后置生成 -->
            <Border CornerRadius="10" BorderThickness="1" Margin="0,16,0,0" Padding="22,20"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE8FD;" FontSize="17" Margin="0,0,12,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{l:Loc Bridge_StepsTitle}" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="StepsPanel" Margin="2,20,0,0"/>
                </StackPanel>
            </Border>

            <!-- 说明 -->
            <Border CornerRadius="10" BorderThickness="1" Margin="0,16,0,0" Padding="22,18"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE946;" FontSize="17" Margin="0,0,12,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{l:Loc Bridge_NoteTitle}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="NoteText" FontSize="13" Margin="0,12,0,0"
                               TextWrapping="Wrap" LineHeight="21"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </controls:SmoothScrollViewer>
</Window>
