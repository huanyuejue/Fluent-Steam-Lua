<Window x:Class="SteamLuaManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SteamLuaManager.Markup"
        Title="{l:Loc Login_Title}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{l:Loc Login_Title}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <TextBlock Text="{l:Loc Login_Desc}"
                   FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <!-- 步骤一：选登录方式 -->
        <StackPanel x:Name="MethodPanel">
            <TextBlock Text="{l:Loc Login_MethodTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MethodLocalButton" Grid.Column="0" Click="MethodLocalButton_Click"
                        Padding="16,14" Margin="0,0,6,0" HorizontalContentAlignment="Left">
                    <Button.Content>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Login_MethodLocal}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{l:Loc Login_MethodLocalDesc}" FontSize="12" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button x:Name="MethodPasswordButton" Grid.Column="1" Click="MethodPasswordButton_Click"
                        Padding="16,14" Margin="6,0,0,0" HorizontalContentAlignment="Left">
                    <Button.Content>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Login_MethodPassword}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{l:Loc Login_MethodPasswordDesc}" FontSize="12" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </Grid>
        </StackPanel>

        <!-- 步骤二A：本地账号 -->
        <StackPanel x:Name="LocalPanel" Visibility="Collapsed">
            <TextBlock Text="{l:Loc Login_LocalTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <ListBox x:Name="LocalAccountList" MaxHeight="180" Margin="0,0,0,8" Padding="0,0,10,0"
                     SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent" BorderThickness="0">
                <ListBox.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,6,6"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="8" Padding="6"
                                            Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="8" Margin="0,0,8,0"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PersonaName}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding AccountName}" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LocalLoginButton" Content="{l:Loc Login_LocalLogin}" Click="LocalLoginButton_Click"
                        Padding="16,6" Height="36" Margin="0,0,8,0"/>
                <Button Content="{l:Loc Login_Back}" Click="BackButton_Click"
                        Padding="16,6" Height="36"/>
            </StackPanel>
        </StackPanel>

        <!-- 步骤二B：账号密码 -->
        <StackPanel x:Name="CredentialRootPanel" Visibility="Collapsed">
            <TextBlock Text="{l:Loc Login_CredTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <StackPanel x:Name="CredentialPanel">
                <Grid Margin="0,0,0,8">
                    <TextBox x:Name="UsernameBox" Padding="8,6" Height="36" FontSize="14"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="{l:Loc Login_UsernameWatermark}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=UsernameBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <PasswordBox x:Name="PasswordBox" Padding="8,6" Height="36" FontSize="14"
                                 VerticalContentAlignment="Center"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBlock x:Name="PasswordHint" Text="{l:Loc Login_PasswordWatermark}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PasswordLoginButton" Content="{l:Loc Login_PasswordLogin}" Click="PasswordLoginButton_Click"
                            Padding="16,6" Height="36" Margin="0,0,8,0"/>
                    <Button Content="{l:Loc Login_Back}" Click="BackButton_Click"
                            Padding="16,6" Height="36"/>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="TwoFactorPanel" Visibility="Collapsed">
                <TextBlock x:Name="TwoFactorPrompt" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBox x:Name="TwoFactorCodeBox" Padding="8,6" Height="36" FontSize="14" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:Loc Login_Confirm}" Click="TwoFactorOkButton_Click"
                            Padding="16,6" Height="36" Margin="0,0,8,0"/>
                    <Button Content="{l:Loc Login_Cancel2FA}" Click="TwoFactorCancelButton_Click"
                            Padding="16,6" Height="36"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="StatusText" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Button Content="{l:Loc Login_Close}" Click="CloseButton_Click" HorizontalAlignment="Right"
                Padding="16,6" Margin="0,12,0,0"/>
    </StackPanel>
</Window>
