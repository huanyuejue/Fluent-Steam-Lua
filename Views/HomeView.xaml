<UserControl x:Class="SteamLuaManager.Views.HomeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:controls="clr-namespace:SteamLuaManager.Controls"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>

        <Grid Margin="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题区域 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="已入库的游戏" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{Binding RefreshProgressText}" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RefreshGamesCommand}" Padding="16,6" Height="36" FontSize="14" Margin="4,0">
                    <Button.Background>
                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE72C;" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="刷新" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddFilesCommand}" Padding="16,6" Height="36" FontSize="14" Margin="4,0">
                    <Button.Background>
                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE710;" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="添加游戏" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenLuaFolderCommand}" Padding="16,6" Height="36" FontSize="14" Margin="4,0">
                    <Button.Background>
                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE838;" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="打开目录" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 搜索、视图、排序栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:AutoSuggestBox Grid.Column="0" x:Name="SearchBox"
                               PlaceholderText="搜索游戏名称或 AppID"
                               QuerySubmitted="SearchBox_QuerySubmitted"
                               TextChanged="SearchBox_TextChanged"
                               Margin="0,0,12,0" HorizontalAlignment="Stretch">
                <ui:AutoSuggestBox.Background>
                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                </ui:AutoSuggestBox.Background>
                <ui:AutoSuggestBox.QueryIcon>
                    <ui:FontIcon Glyph="&#xE721;"/>
                </ui:AutoSuggestBox.QueryIcon>
            </ui:AutoSuggestBox>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                <TextBlock Text="筛选:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="DisableFilterComboBox"
                          SelectedValuePath="Content"
                          SelectedValue="{Binding SelectedDisableFilter, Mode=TwoWay}"
                          MinWidth="100" Padding="12,6"
                          HorizontalContentAlignment="Center">
                    <ComboBox.Background>
                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                    </ComboBox.Background>
                    <ComboBoxItem Content="全部游戏"/>
                    <ComboBoxItem Content="已启用入库"/>
                    <ComboBoxItem Content="已禁用入库"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
                <TextBlock Text="视图:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="ViewModeComboBox"
                          SelectedValuePath="Content"
                          SelectedValue="{Binding SelectedViewMode, Mode=TwoWay}"
                          MinWidth="70" Padding="12,6"
                          HorizontalContentAlignment="Center">
                    <ComboBox.Background>
                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                    </ComboBox.Background>
                    <ComboBoxItem Content="卡片"/>
                    <ComboBoxItem Content="列表"/>
                    <ComboBoxItem Content="表格"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,12,0">
                <TextBlock Text="排序:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="SortComboBox"
                          SelectedValuePath="Content"
                          SelectedValue="{Binding SelectedSortOption, Mode=TwoWay}"
                          MinWidth="110" Padding="12,6"
                          HorizontalContentAlignment="Center">
                    <ComboBox.Background>
                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                    </ComboBox.Background>
                    <ComboBoxItem Content="名称 A-Z"/>
                    <ComboBoxItem Content="名称 Z-A"/>
                    <ComboBoxItem Content="AppID 升序"/>
                    <ComboBoxItem Content="AppID 降序"/>
                    <ComboBoxItem Content="入库时间升序"/>
                    <ComboBoxItem Content="入库时间降序"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- 批量操作栏 -->
        <Grid Grid.Row="2" Margin="0,0,0,16"
              Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding SelectAllCommand}" Padding="10,6" Margin="0,0,6,0"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="全选" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearSelectionCommand}" Padding="10,6" Margin="6,0,16,0"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="取消选择" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,4,16,4"/>
                <Button Command="{Binding BatchEnableCommand}" Padding="10,6" Margin="0,0,6,0"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="批量启用" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding BatchDisableCommand}" Padding="10,6" Margin="6,0,6,0"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="批量禁用" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding BatchDeleteCommand}" Padding="10,6" Margin="6,0,0,0"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="批量删除" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ToggleSelectionModeCommand}" Padding="10,6" Margin="0,0,16,0"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="退出批量管理" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="已选择 "/>
                    <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                    <Run Text=" 个游戏"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- 游戏内容区域（加载时保持显示，不改变页面配色） -->
        <Grid Grid.Row="4">

            <!-- 卡片模式 -->
            <ScrollViewer x:Name="CardScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Loaded="ViewModeContainer_Loaded"
                          Visibility="{Binding SelectedViewMode, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=卡片}">
                <ItemsControl x:Name="CardItemsControl" ItemsSource="{Binding Games}" Margin="0,0,-16,16"
                              HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ClippingBorder Margin="0,0,16,16" Width="220" CornerRadius="12"
                                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Tag="{Binding}">
                                <controls:ClippingBorder.Background>
                                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                                </controls:ClippingBorder.Background>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="120"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Rectangle Grid.Row="0" Fill="{DynamicResource ControlFillColorDefaultBrush}"/>
                                        <Image Grid.Row="0"
                                               Source="{Binding CoverImagePath, Converter={StaticResource FilePathToImageConverter}}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               x:Name="CoverImage">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter Property="Opacity" Value="0.35"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Button Grid.Row="0"
                                                Visibility="{Binding DataContext.IsCardRefreshVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding DataContext.RefreshSingleGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,6,6" Padding="0" Width="26" Height="26"
                                                Background="#AA000000" BorderThickness="0"
                                                ToolTip="重新获取封面和名称">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse Fill="{TemplateBinding Background}"/>
                                                        <Ellipse Name="Overlay" Fill="Transparent"/>
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Overlay" Property="Fill" Value="#22FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Overlay" Property="Fill" Value="#44FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="White"
                                                       TextOptions.TextFormattingMode="Display"
                                                       TextOptions.TextRenderingMode="ClearType"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Rectangle Grid.Row="0" Fill="#60000000"
                                                   x:Name="DisabledCoverOverlay">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <CheckBox Grid.Row="0" Width="20" Height="20" MinWidth="20" MinHeight="20" Padding="0"
                                                  FocusVisualStyle="{x:Null}"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Top" HorizontalAlignment="Left"
                                                  Margin="6"
                                                  Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>
                                        <TextBlock Grid.Row="1" Text="{Binding GameName}"
                                                   HorizontalAlignment="Left"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   Margin="12,10,12,2" TextTrimming="CharacterEllipsis"
                                                   Cursor="Hand" ToolTip="点击复制游戏名"
                                                   MouseEnter="CopyableText_MouseEnter"
                                                   MouseLeave="CopyableText_MouseLeave"
                                                   MouseLeftButtonDown="GameNameText_MouseLeftButtonDown">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Row="2" FontSize="12" Margin="12,0,12,8"
                                                   Cursor="Hand" ToolTip="点击复制 AppID"
                                                   MouseEnter="CopyableText_MouseEnter"
                                                   MouseLeave="CopyableText_MouseLeave"
                                                   MouseLeftButtonDown="AppIdText_MouseLeftButtonDown"
                                                   x:Name="AppIdText">
                                            <Run Text="AppID: "/>
                                            <Run Text="{Binding AppId, Mode=OneWay}"/>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Grid Grid.Row="3" Margin="12,0,8,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SystemAccentColorBrush}"
                                                       Text="● 版本已固定">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsManifestPinned}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Grid.Column="1" Tag="{Binding}" Click="MoreButton_Click"
                                                    Padding="6,4" FontSize="12" Background="Transparent" BorderThickness="0">
                                                <ui:FontIcon Glyph="&#xE712;" FontSize="16"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                            </controls:ClippingBorder>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 列表模式 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Loaded="ViewModeContainer_Loaded"
                          Padding="0,0,20,0"
                          Visibility="{Binding SelectedViewMode, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=列表}">
                <StackPanel Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Margin="0,0,0,6" Padding="12"
                                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Width="20" Height="20" MinWidth="20" MinHeight="20" Padding="0"
                                                  FocusVisualStyle="{x:Null}"
                                                  IsChecked="{Binding IsSelected}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>

                                        <controls:ClippingBorder Grid.Column="1" CornerRadius="6" ClipToBounds="True"
                                                 Margin="10,0,0,0"
                                                 Width="120" Height="52" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                 BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid>
                                                <Image Source="{Binding CoverImagePath, Converter={StaticResource FilePathToImageConverter}}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.35"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <Rectangle Fill="#60000000">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                            </Grid>
                                        </controls:ClippingBorder>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0">
                                            <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" FontSize="14"
                                                       HorizontalAlignment="Left"
                                                       TextTrimming="CharacterEllipsis"
                                                       Cursor="Hand" ToolTip="点击复制游戏名"
                                                       MouseEnter="CopyableText_MouseEnter"
                                                       MouseLeave="CopyableText_MouseLeave"
                                                       MouseLeftButtonDown="GameNameText_MouseLeftButtonDown">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock FontSize="12"
                                                           Cursor="Hand" ToolTip="点击复制 AppID"
                                                           MouseEnter="CopyableText_MouseEnter"
                                                           MouseLeave="CopyableText_MouseLeave"
                                                           MouseLeftButtonDown="AppIdText_MouseLeftButtonDown">
                                                    <Run Text="AppID: "/>
                                                    <Run Text="{Binding AppId, Mode=OneWay}"/>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    <Setter Property="Opacity" Value="0.5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontSize="10" Margin="10,0,0,0"
                                                           Foreground="{DynamicResource SystemAccentColorBrush}"
                                                           Text="● 版本已固定">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsManifestPinned}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Visibility="{Binding DataContext.IsCardRefreshVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.RefreshSingleGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,4" Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    ToolTip="重新获取封面和名称">
                                                <ui:FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                            </Button>
                                            <Button Tag="{Binding}" Click="MoreButton_Click"
                                                    Padding="8,6" Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <ui:FontIcon Glyph="&#xE712;" FontSize="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 表格模式 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Loaded="ViewModeContainer_Loaded"
                          Visibility="{Binding SelectedViewMode, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=表格}">
                <Grid Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                     <Border Grid.Row="0" CornerRadius="8,8,0,0">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Width="16"
                                       Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Fill="Transparent"/>
                            <TextBlock Grid.Column="1" Text="游戏名称" FontWeight="SemiBold" FontSize="13" Padding="14,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="版本状态" FontWeight="SemiBold" FontSize="13" Padding="10,9"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="入库状态" FontWeight="SemiBold" FontSize="13" Padding="10,9"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="AppID" FontWeight="SemiBold" FontSize="13" Padding="14,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="5" FontWeight="SemiBold" FontSize="13" Padding="12,10"/>
                        </Grid>
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Width="20" Height="20" MinWidth="20" MinHeight="20" Padding="0"
                                                  Margin="14,0,0,0"
                                                  FocusVisualStyle="{x:Null}"
                                                  IsChecked="{Binding IsSelected}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GameName}" FontSize="13" Padding="14,9"
                                                   HorizontalAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"
                                                   Cursor="Hand" ToolTip="点击复制游戏名"
                                                   MouseEnter="CopyableText_MouseEnter"
                                                   MouseLeave="CopyableText_MouseLeave"
                                                   MouseLeftButtonDown="GameNameText_MouseLeftButtonDown">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" FontSize="13" Padding="10,9"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="未固定"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsManifestPinned}" Value="True">
                                                            <Setter Property="Text" Value="已固定"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" FontSize="13" Padding="10,9"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="已启用"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter Property="Text" Value="已禁用"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="4" Text="{Binding AppId}" FontSize="13" Padding="14,9"
                                                   Cursor="Hand" ToolTip="点击复制 AppID"
                                                   MouseEnter="CopyableText_MouseEnter"
                                                   MouseLeave="CopyableText_MouseLeave"
                                                   MouseLeftButtonDown="AppIdText_MouseLeftButtonDown">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Visibility="{Binding DataContext.IsCardRefreshVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.RefreshSingleGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="4,4" Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    ToolTip="重新获取封面和名称">
                                                <ui:FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                            </Button>
                                            <Button Tag="{Binding}" Click="MoreButton_Click"
                                                    Padding="6,4" Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <ui:FontIcon Glyph="&#xE712;" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 空状态提示 -->
        <StackPanel Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"
                    Visibility="{Binding Games.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
            <ui:FontIcon Glyph="&#xE7F0;" FontSize="48" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            <TextBlock Text="还没有入库的游戏" FontSize="18" HorizontalAlignment="Center" Margin="0,16,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="将 .lua 或 .bin 文件拖拽到此处，或点击上方添加游戏按钮" FontSize="13"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </StackPanel>

        </Grid>

<!-- 游戏卡片扩展菜单（与悬浮按钮面板同类实现） -->
        <Canvas x:Name="CardMenuCanvas" Panel.ZIndex="90" IsHitTestVisible="True">
            <Border x:Name="CardMenuPanel" Canvas.Left="0" Canvas.Top="0"
                    MinWidth="128" MaxWidth="172" Padding="6" CornerRadius="10"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="Collapsed"
                    RenderTransformOrigin="0.5,0"
                    MouseLeave="CardMenuPanel_MouseLeave">
                <Border.RenderTransform>
                    <ScaleTransform ScaleY="1"/>
                </Border.RenderTransform>
                <ItemsControl x:Name="CardMenuList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border x:Name="Divider" Height="1" Margin="6,1"
                                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        Visibility="Collapsed"/>
                                <Border x:Name="MenuItemBorder" Padding="10,7" Cursor="Hand" CornerRadius="6"
                                        Background="Transparent" BorderThickness="0"
                                        Tag="{Binding}"
                                        MouseLeftButtonDown="CardMenuItem_MouseLeftButtonDown"
                                        MouseEnter="CardMenuItem_MouseEnter"
                                        MouseLeave="CardMenuItem_MouseLeave">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Header}" FontSize="14" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ui:FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="10" Margin="2,0,0,0"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding HasSubmenu, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter TargetName="Divider" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="MenuItemBorder" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border x:Name="CardSubmenuPanel" Canvas.Left="0" Canvas.Top="0"
                    MinWidth="170" MaxWidth="240" Padding="6" CornerRadius="10"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="Collapsed"
                    RenderTransformOrigin="0.5,0"
                    MouseEnter="CardSubmenuPanel_MouseEnter"
                    MouseLeave="CardSubmenuPanel_MouseLeave">
                <Border.RenderTransform>
                    <ScaleTransform ScaleY="1"/>
                </Border.RenderTransform>
                <ItemsControl x:Name="CardSubmenuList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border x:Name="Divider" Height="1" Margin="6,1"
                                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        Visibility="Collapsed"/>
                                <Border x:Name="SubmenuItemBorder" Padding="10,7" Margin="0,1,0,0" CornerRadius="6"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Tag="{Binding}"
                                    MouseLeftButtonDown="CardSubmenuItem_MouseLeftButtonDown"
                                    MouseEnter="CardSubmenuItem_MouseEnter"
                                    MouseLeave="CardSubmenuItem_MouseLeave">
                                    <TextBlock Text="{Binding Header}" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter TargetName="Divider" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="SubmenuItemBorder" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Canvas>

        <ui:InfoBar VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Margin="36,0,36,24"
                    Panel.ZIndex="10"
                    IsOpen="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                    Message="{Binding StatusMessage}"
                    Severity="Informational"
                    IsClosable="False"
                    ui:ControlHelper.CornerRadius="8"/>

    </Grid>
</UserControl>
