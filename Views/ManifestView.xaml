<UserControl xmlns:controls="clr-namespace:SteamLuaManager.Controls" x:Class="SteamLuaManager.Views.ManifestView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SteamLuaManager.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="PillButtonStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6" BorderThickness="0">
                            <ContentPresenter ContentSource="Content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,24,36,24">

            <TextBlock Text="{l:Loc Manifest_Title}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="{l:Loc Manifest_Desc1}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{l:Loc Manifest_Desc2}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 页签：Code直下 / ManifestHub -->
            <Border CornerRadius="10" Padding="12" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" Content="{l:Loc Manifest_TabCode}"
                                 IsChecked="{Binding IsShowingCode, Mode=OneWay}"
                                 Style="{StaticResource PillButtonStyle}"
                                 Command="{Binding ShowCodeViewCommand}"/>
                    <RadioButton Grid.Column="1" Content="{l:Loc Manifest_TabHub}"
                                 IsChecked="{Binding IsShowingHub, Mode=OneWay}"
                                 Style="{StaticResource PillButtonStyle}"
                                 Command="{Binding ShowHubViewCommand}"/>
                </Grid>
            </Border>

            <!-- ===== Code 直下 ===== -->
            <StackPanel x:Name="CodeContentPanel" Visibility="{Binding IsShowingCode, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{l:Loc Manifest_CodeDesc}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{l:Loc Manifest_GuideTitle}" FontWeight="SemiBold"/><Run Text="{l:Loc Manifest_CodeGuide}"/>
                    </TextBlock>
                </StackPanel>

                <!-- 启停 -->
                <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{l:Loc Manifest_StartMonitor}" Padding="20,6" Margin="0,0,8,0"
                                 Command="{Binding StartCodeMonitorCommand}"
                                IsEnabled="{Binding IsCodeMonitoring, Converter={StaticResource BoolInvertConverter}}"/>
                        <Button Content="{l:Loc Manifest_StopMonitor}" Padding="20,6" Margin="0,0,16,0"
                                 Command="{Binding StopCodeMonitorCommand}"
                                IsEnabled="{Binding IsCodeMonitoring}"/>
                            <TextBlock VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding CodeFoundSummary}"/>
                    </StackPanel>
                </Border>

                <!-- 日志 -->
                <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                    </Border.Background>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CodeStatusMessage}" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="CopyCodeLogButton" Content="{l:Loc Common_CopyLog}" Padding="12,4" Margin="0,0,8,0"
                                        Click="CopyCodeLogButton_Click" Visibility="Collapsed"/>
                                <Button Content="{l:Loc Common_ClearLog}" Padding="12,4"
                                        Command="{Binding ClearCodeLogCommand}"
                                        Visibility="{Binding CodeLogLines.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <TextBlock Text="{l:Loc Common_NoLog}" Style="{StaticResource LogEmptyStyle}"
                                       Visibility="{Binding CodeLogLines.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CodeLogLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas,微软雅黑" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,1"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== ManifestHub ===== -->
            <StackPanel x:Name="HubContentPanel" Visibility="{Binding IsShowingHub, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{l:Loc Manifest_HubDesc}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{l:Loc Manifest_GuideTitle}" FontWeight="SemiBold"/><Run Text="{l:Loc Manifest_HubGuide}"/>
                    </TextBlock>
                </StackPanel>

                <!-- API Key -->
                <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                    </Border.Background>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyBox" Grid.Column="0"
                                         Padding="8,6" Height="36" FontSize="14"
                                         VerticalContentAlignment="Center" Margin="0,0,8,0"
                                         PasswordChanged="ApiKeyBox_PasswordChanged"/>
                            <Button Grid.Column="1" Content="{l:Loc Manifest_GetKey}" Padding="20,6" Margin="0,0,8,0"
                                    Click="GetKeyButton_Click"/>
                            <Button Grid.Column="2" Content="{l:Loc Manifest_SaveKey}" Padding="20,6"
                                    Click="SaveKeyButton_Click"/>
                        </Grid>
                        <TextBlock Text="{Binding KeyStatusText}" Margin="0,8,0,0" FontSize="12"
                                   Foreground="{Binding KeyStatusForeground}"/>
                    </StackPanel>
                </Border>

                <!-- 启停 -->
                <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{l:Loc Manifest_StartMonitor}" Padding="20,6" Margin="0,0,8,0"
                                 Command="{Binding StartHubMonitorCommand}"
                                IsEnabled="{Binding IsHubMonitoring, Converter={StaticResource BoolInvertConverter}}"/>
                        <Button Content="{l:Loc Manifest_StopMonitor}" Padding="20,6" Margin="0,0,16,0"
                                 Command="{Binding StopHubMonitorCommand}"
                                IsEnabled="{Binding IsHubMonitoring}"/>
                            <TextBlock VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding HubFoundSummary}"/>
                    </StackPanel>
                </Border>

                <!-- 日志 -->
                <Border CornerRadius="10" Padding="16" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                    </Border.Background>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding HubStatusMessage}" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="CopyHubLogButton" Content="{l:Loc Common_CopyLog}" Padding="12,4" Margin="0,0,8,0"
                                        Click="CopyHubLogButton_Click" Visibility="Collapsed"/>
                                <Button Content="{l:Loc Common_ClearLog}" Padding="12,4"
                                        Command="{Binding ClearHubLogCommand}"
                                        Visibility="{Binding HubLogLines.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <TextBlock Text="{l:Loc Common_NoLog}" Style="{StaticResource LogEmptyStyle}"
                                       Visibility="{Binding HubLogLines.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding HubLogLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas,微软雅黑" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,1"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </controls:SmoothScrollViewer>
</UserControl>
