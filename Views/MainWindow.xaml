<Window x:Class="SteamLuaManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="Fluent Steam Lua 管理工具"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="780" Width="1050"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Acrylic10"
        ui:WindowHelper.CornerStyle="Round"
        ui:WindowHelper.FixMaximizedWindow="True"
        ui:TitleBar.Height="40"
        Background="Transparent"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Background="Transparent">
        <ui:NavigationView x:Name="NavView"
                           PaneDisplayMode="Left"
                           IsPaneOpen="False"
                            OpenPaneLength="115"
                            CompactPaneLength="48"
                           IsSettingsVisible="False"
                           IsBackEnabled="False"
                           IsBackButtonVisible="Collapsed"
                           SelectionChanged="NavView_SelectionChanged"
                           Background="Transparent">
            <ui:NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
            </ui:NavigationView.Resources>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="HomeItem" Content="主页" Tag="Home" Padding="12,0">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE80F;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="ScriptDownloadItem" Content="入库" Tag="ScriptDownload" Padding="12,0">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE990;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="ExtractionItem" Content="提取" Tag="Extraction" Padding="12,0">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="TrainerItem" Content="修改器" Tag="Trainer" Padding="12,0">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE7FC;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="SettingsItem" Content="设置" Tag="Settings" Padding="12,0">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE713;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="AboutItem" Content="关于" Tag="About" Padding="12,0">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE9CE;" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <!-- 主内容区域 -->
            <Grid>
                <Border VerticalAlignment="Stretch" HorizontalAlignment="Left"
                        Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="1,8,0,8"/>
                <ui:TransitioningContentControl x:Name="ContentTransition"
                                                 Transition="RightReplace"
                                                 Background="{x:Null}"/>
            </Grid>
        </ui:NavigationView>

        <!-- 浮动 Steam 快捷操作按钮 -->
        <Canvas x:Name="FabCanvas" Panel.ZIndex="100" IsHitTestVisible="True">

            <!-- 展开面板 -->
            <Border x:Name="SteamPanel" Canvas.Left="0" Canvas.Top="0"
                    MinWidth="130" MaxWidth="200" Padding="6" CornerRadius="10"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="Collapsed" SizeChanged="SteamPanel_SizeChanged">
                <Border.RenderTransform>
                    <ScaleTransform ScaleY="1"/>
                </Border.RenderTransform>
                <Border.RenderTransformOrigin>0.5,1</Border.RenderTransformOrigin>
                <Border.Resources>
                    <Storyboard x:Key="OpenPanel">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.85" To="1" Duration="0:0:0.15">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                    <Storyboard x:Key="ClosePanel">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.1"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="0.85" Duration="0:0:0.1">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </Border.Resources>
                <ItemsControl x:Name="SteamMenuList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border x:Name="Divider" Height="1" Margin="6,2"
                                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        Visibility="Collapsed"/>
                                <Border x:Name="MenuItemBorder" Padding="10,8" Cursor="Hand" CornerRadius="6"
                                        Background="Transparent" BorderThickness="0"
                                        Tag="{Binding}"
                                        MouseLeftButtonDown="FabMenuItem_MouseLeftButtonDown"
                                        MouseEnter="FabMenuItem_MouseEnter"
                                        MouseLeave="FabMenuItem_MouseLeave">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <ui:FontIcon Glyph="{Binding Glyph}" FontSize="14" Margin="0,0,8,0"
                                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Header}" FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                        <ui:FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="10" Margin="4,0,0,0"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding HasSubmenu, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter TargetName="Divider" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="MenuItemBorder" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 账号子菜单 -->
            <Border x:Name="AccountSubmenu" Canvas.Left="0" Canvas.Top="0"
                    Width="160" Padding="4" CornerRadius="8"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="Collapsed"
                    MouseEnter="AccountSubmenu_MouseEnter"
                    MouseLeave="AccountSubmenu_MouseLeave">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                </Border.RenderTransform>
                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                <Border.Resources>
                    <Storyboard x:Key="OpenSubmenu">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.9" To="1" Duration="0:0:0.12">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.9" To="1" Duration="0:0:0.12">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                    <Storyboard x:Key="CloseSubmenu">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.08"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="0.9" Duration="0:0:0.08">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="0.9" Duration="0:0:0.08">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </Border.Resources>
                <ItemsControl x:Name="AccountList" Margin="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border x:Name="Divider" Height="1" Margin="6,2"
                                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        Visibility="Collapsed"/>
                                <Border x:Name="AccountItemBorder" Padding="8,6" Margin="0,1,0,0" CornerRadius="4"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Tag="{Binding}"
                                        MouseLeftButtonDown="AccountItem_Click"
                                        MouseEnter="FabSubmenuItem_MouseEnter"
                                        MouseLeave="FabSubmenuItem_MouseLeave">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" Margin="0,0,8,0" CornerRadius="6"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    VerticalAlignment="Center">
                                                <Border.Clip>
                                                    <RectangleGeometry RadiusX="6" RadiusY="6" Rect="0,0,32,32"/>
                                                </Border.Clip>
                                                <Image Width="32" Height="32" Stretch="UniformToFill" Source="{Binding AvatarPath}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PersonaName}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding AccountName}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter TargetName="Divider" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="AccountItemBorder" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 内核管理子菜单 -->
            <Border x:Name="KernelSubmenu" Canvas.Left="0" Canvas.Top="0"
                    Width="180" Padding="4" CornerRadius="8"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="Collapsed"
                    MouseEnter="KernelSubmenu_MouseEnter"
                    MouseLeave="KernelSubmenu_MouseLeave">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                </Border.RenderTransform>
                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                <Border.Resources>
                    <Storyboard x:Key="OpenSubmenu">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.9" To="1" Duration="0:0:0.12">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.9" To="1" Duration="0:0:0.12">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                    <Storyboard x:Key="CloseSubmenu">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.08"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="0.9" Duration="0:0:0.08">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="0.9" Duration="0:0:0.08">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </Border.Resources>
                <ItemsControl x:Name="KernelList" Margin="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border x:Name="Divider" Height="1" Margin="6,2"
                                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        Visibility="Collapsed"/>
                                <Border x:Name="KernelItemBorder" Padding="8,6" Margin="0,1,0,0" CornerRadius="4"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Tag="{Binding}"
                                        MouseLeftButtonDown="KernelItem_Click"
                                        MouseEnter="KernelMenuItem_MouseEnter"
                                        MouseLeave="FabSubmenuItem_MouseLeave">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="KernelIcon" Text="{Binding IconGlyph}" FontSize="16" Margin="0,0,8,0"
                                                   VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{Binding Foreground}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="KernelTitle" Text="{Binding Header}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{Binding Foreground}"/>
                                        <TextBlock x:Name="KernelDescription" Text="{Binding Description}" FontSize="11"
                                                       Foreground="{Binding DescriptionForeground}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter TargetName="Divider" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="KernelItemBorder" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter TargetName="KernelItemBorder" Property="Cursor" Value="Arrow"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 可拖拽按钮 -->
            <Border x:Name="SteamFab" Canvas.Left="0" Canvas.Top="0"
                    Width="44" Height="44" CornerRadius="22"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" Cursor="Hand"
                    MouseLeftButtonDown="SteamFab_MouseLeftButtonDown"
                    MouseLeftButtonUp="SteamFab_MouseLeftButtonUp"
                    MouseMove="SteamFab_MouseMove"
                    LostMouseCapture="SteamFab_LostMouseCapture">
                <Path Data="M22.7,19L13.6,9.9C14.5,7.6,14,4.9,12.1,3C10.1,1,7.1,0.6,4.7,1.7L9,6L6,9L1.6,4.7C0.4,7.1,0.9,10.1,2.9,12.1C4.8,14,7.5,14.5,9.8,13.6L18.9,22.7C19.3,23.1,19.9,23.1,20.3,22.7L22.6,20.4C23.1,20,23.1,19.3,22.7,19Z"
                      Stretch="Uniform" Fill="{DynamicResource TextFillColorPrimaryBrush}" Width="18" Height="18"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Canvas>

        <!-- OpenSteamTool 安装/更新遮罩层 -->
        <Grid x:Name="KernelOverlayGrid" Panel.ZIndex="210"
              Visibility="Collapsed" Background="#80000000" IsHitTestVisible="True">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="400" MinHeight="150" CornerRadius="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Margin="24,20">
                    <TextBlock x:Name="KernelOverlayStatus" FontSize="14" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="KernelOverlayHint" FontSize="11" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0" Visibility="Collapsed"
                               Text="若下载过慢可尝试开启代理或 VPN"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="KernelOverlayProgressBar" Minimum="0" Maximum="100" Value="0"
                                     Height="6" Visibility="Collapsed"/>
                        <TextBlock x:Name="KernelOverlayPercent" Grid.Column="1" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="10,0,0,0" Visibility="Collapsed" Text="0%"/>
                    </Grid>
                    <ui:ProgressRing x:Name="KernelOverlayRing" IsActive="True" Width="28" Height="28"
                                     Margin="0,12,0,0" HorizontalAlignment="Left"/>
                    <Button x:Name="KernelCancelButton" Content="取消" Margin="0,14,0,0"
                            Padding="12,6" FontSize="13" HorizontalAlignment="Center"
                            Click="KernelCancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DLC 查询遮罩层 -->
        <Grid Panel.ZIndex="200"
              Visibility="{Binding IsDlcQueryOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#80000000" IsHitTestVisible="True">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="320" MinHeight="120" CornerRadius="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,16">
                    <ui:ProgressRing IsActive="True" Width="32" Height="32"
                                     HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DlcQueryOverlayText}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,12,0,0"
                               FontSize="14" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               TextAlignment="Center"/>
                    <Button Content="取消" Margin="0,14,0,0"
                            Padding="12,6" FontSize="13" HorizontalAlignment="Center"
                            Command="{Binding CancelDlcQueryCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
