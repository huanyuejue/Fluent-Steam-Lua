<Window x:Class="SteamLuaManager.Views.AchievementEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="成就编辑"
        Height="720" Width="840"
        MinHeight="480" MinWidth="640"
        MaxHeight="1600" MaxWidth="1600"
        WindowStartupLocation="CenterOwner"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.CornerStyle="Round"
        ui:WindowHelper.FixMaximizedWindow="True"
        ui:TitleBar.Height="40"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Background="Transparent" Margin="36,28,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 操作按钮 -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding GameName}" FontSize="22" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{Binding AppIdText}" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="重新加载" Command="{Binding ReloadCommand}" Margin="0,0,6,0" Height="36" Padding="16,6"/>
                <Button Content="全部解锁" Command="{Binding UnlockAllCommand}" Margin="0,0,6,0" Height="36" Padding="16,6"/>
                <Button Content="全部锁定" Command="{Binding LockAllCommand}" Margin="0,0,6,0" Height="36" Padding="16,6"/>
                <Button Content="反选" Command="{Binding InvertAllCommand}" Margin="0,0,6,0" Height="36" Padding="16,6"/>
                <Button Content="保存到 Steam" Command="{Binding SaveCommand}" Height="36" Padding="16,6"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!-- 成就列表 -->
            <Border CornerRadius="8"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" Padding="8">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="成就" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,6"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Achievements}"
                                      Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Background="Transparent" Margin="0,0,0,4"
                                            Padding="6,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:ToggleSwitch IsOn="{Binding IsAchieved, Mode=TwoWay}"
                                                             IsEnabled="{Binding IsProtected, Converter={StaticResource BoolInvertConverter}}"
                                                             OnContent="" OffContent=""
                                                             Width="44" MinWidth="0"
                                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                            <Border Grid.Column="1" Width="52" Height="52" CornerRadius="6"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}" Margin="0,0,10,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IconUrl}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Image Source="{Binding IconUrl}" Width="48" Height="48"
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Opacity" Value="0.35"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAchieved}" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12" Margin="6,0,0,0"
                                                               Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibilityConverter}}"
                                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                               ToolTip="受保护，不可修改"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{Binding UnlockTimeText}" FontSize="11"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding UnlockTimeText, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ui:ProgressRing Grid.Row="1" IsActive="{Binding IsBusy}" Width="40" Height="40"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="{Binding EmptyHintText}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding EmptyHintText, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
                </Grid>
            </Border>
        </Grid>

        <ui:InfoBar Grid.Row="2" Style="{StaticResource InfoBarStyle}"
                    IsOpen="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                    Message="{Binding StatusMessage}"
                    HorizontalAlignment="Left"
                    Margin="0,12,0,0"/>
    </Grid>
</Window>
