<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Updater</RootNamespace>
    <AssemblyName>Updater</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Services\LocalizationService.cs" Link="LocalizationService.cs" />
    <Compile Include="..\Services\L.cs" Link="L.cs" />
    <EmbeddedResource Include="..\Resources\Lang\*.json" LogicalName="SteamLuaManager.Resources.Lang.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
