<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">

    <!-- 浮层阴影：仅用于菜单面板 / 遮罩卡片 / FAB，静态卡片保持平面 -->
    <DropShadowEffect x:Key="FloatingShadow" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.3"/>
    <DropShadowEffect x:Key="FabShadow" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.32"/>

    <!-- Home 卡片细节色：深色打底保证白色图标两主题可读 -->
    <SolidColorBrush x:Key="CardRefreshButtonFill" Color="#AA000000"/>
    <SolidColorBrush x:Key="CardDisabledOverlayFill" Color="#60000000"/>

    <!-- 设置卡片：统一圆角 10 + 0.45 半透明背景 -->
    <Style x:Key="SettingsCardStyle" TargetType="{x:Type ui:SettingsCard}">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="ui:ControlHelper.CornerRadius" Value="10"/>
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- InfoBar 统一外观：透明无边框（旧版观感），仅统一圆角与文本色 -->
    <Style x:Key="InfoBarStyle" TargetType="{x:Type ui:InfoBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Severity" Value="Informational"/>
        <Setter Property="IsClosable" Value="False"/>
        <Setter Property="ui:ControlHelper.CornerRadius" Value="8"/>
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Style>
        </Style.Resources>
    </Style>

    <!-- 加载遮罩卡片样式（含阴影），供遮罩层引用 -->
    <Style x:Key="OverlayCardShadowStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="32"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect" Value="{StaticResource FloatingShadow}"/>
    </Style>

</ResourceDictionary>