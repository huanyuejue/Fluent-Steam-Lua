<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <TargetPlatformVersion>10.0.18362.0</TargetPlatformVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName Condition="'$(AppExeName)' != ''">$(AppExeName)</AssemblyName>
    <AssemblyName Condition="'$(AppExeName)' == ''">SteamLuaManager</AssemblyName>
    <RootNamespace>SteamLuaManager</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Title>Fluent Steam Lua 管理工具</Title>
    <Product>Fluent Steam Lua 管理工具</Product>
    <Version>1.5.4.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="iNKORE.UI.WPF" Version="1.2.8" />
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="SteamKit2" Version="3.4.0" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms 引入的隐式全局 using 与 WPF 命名冲突，仅托盘文件显式引用 -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <PropertyGroup>
    <!-- CloudRedirect 原生 DLL：构建时自动拉取自家保留仓 Release 成品并验签，仓库内不存放源码与二进制。
         默认 latest，跟随上游最新 Release；需要复现旧构建时可固定，例如
         dotnet build -p:CloudRedirectVersion=v2.6.5 -->
    <CloudRedirectVersion Condition="'$(CloudRedirectVersion)' == ''">latest</CloudRedirectVersion>
    <!-- 缓存根目录：任务内部按实际解析到的 Release tag 分子目录，最新版与固定版互不覆盖 -->
    <CloudRedirectDllRoot>$(ProjectDir)obj\CloudRedirectDll</CloudRedirectDllRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="SvcMonitor\**\*" />
    <EmbeddedResource Remove="SvcMonitor\**\*" />
    <None Remove="SvcMonitor\**\*" />
    <Compile Remove="Updater\**\*" />
    <EmbeddedResource Remove="Updater\**\*" />
    <None Remove="Updater\**\*" />
    <Compile Remove="CrackTool\**\*" />
    <EmbeddedResource Remove="CrackTool\**\*" />
    <None Remove="CrackTool\**\*" />
    <!-- thirdparty 是外部源码归档（CloudRedirect 保留库自有工程），不参与本工程编译 -->
    <Compile Remove="thirdparty\**\*" />
    <EmbeddedResource Remove="thirdparty\**\*" />
    <None Remove="thirdparty\**\*" />
    <Page Remove="thirdparty\**\*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\SvcMonitor.zip" />
    <EmbeddedResource Include="Resources\Updater.zip" />
    <EmbeddedResource Include="Resources\CloudRedirectDll.zip" />
    <EmbeddedResource Include="Resources\Lang\*.json" />
    <Compile Include="obj\Generated\FeedbackSecrets.g.cs" />
  </ItemGroup>

  <!-- 免启动破解：进程内引用 SteamAutoCrack.Core（已改 net8/x64，随主程序编译） -->
  <ItemGroup>
    <!-- 改名只走 AppExeName（本工程消费）：NuGet restore 把 AssemblyName 当项目名，
         直接全局传 -p:AssemblyName 会让主工程与 Core 同名而报 Ambiguous project name -->
    <ProjectReference Include="CrackTool\SteamAutoCrack.Core\SteamAutoCrack.Core.csproj" />
  </ItemGroup>

  <!-- 单文件发布时把发布内容（含 CrackTool 的 SteamAPICheckBypass 劫持 DLL）一并打进 exe，
       对外只有一个文件；内容运行时释放到 %TEMP%\.net，程序数据目录仍在 exe 旁不受影响 -->
  <PropertyGroup>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- 原生劫持 DLL 由 Core 工程自带 None 规则跟随输出（SteamAPICheckBypass\ 子目录，
       正是 Core 按 NATIVE_DLL_SEARCH_DIRECTORIES 查找的位置），无需额外拷贝 -->

  <!-- 内嵌更新器与源码同步：每次构建自动重新打包，避免改了 Updater 源码却发出去旧版 -->
  <Target Name="BuildUpdaterForEmbed" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet publish $(ProjectDir)Updater\Updater.csproj -c $(Configuration) -o $(ProjectDir)Resources\UpdaterPublish" />
    <ZipDirectory SourceDirectory="$(ProjectDir)Resources\UpdaterPublish" DestinationFile="$(ProjectDir)Resources\Updater.zip" Overwrite="true" />
    <RemoveDir Directories="$(ProjectDir)Resources\UpdaterPublish" />
  </Target>

  <Target Name="BuildSvcMonitorForEmbed" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet publish $(ProjectDir)SvcMonitor\SvcMonitor.csproj -c $(Configuration) -o $(ProjectDir)Resources\SvcMonitorPublish" />
    <ZipDirectory SourceDirectory="$(ProjectDir)Resources\SvcMonitorPublish"
                  DestinationFile="$(ProjectDir)Resources\SvcMonitor.zip"
                  Overwrite="true" />
    <RemoveDir Directories="$(ProjectDir)Resources\SvcMonitorPublish" />
  </Target>

  <!-- 构建时拉取官方 Release 成品并验签：纯内联任务，不依赖外部脚本与 C++ 工具链 -->
  <UsingTask TaskName="FetchCloudRedirectDll" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Version ParameterType="System.String" Required="true" />
      <RootDir ParameterType="System.String" Required="true" />
      <DllPath ParameterType="System.String" Output="true" />
      <ResolvedVersion ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Net.Http" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var dllName = "cloud_redirect.dll";
        var repo = "https://github.com/huanyuejue/CloudRedirect";
        var spec = (Version ?? "").Trim();
        var wantLatest = spec.Length == 0 || spec.Equals("latest", StringComparison.OrdinalIgnoreCase);

        // latest 时先把"最新"解析成具体 tag：缓存按 tag 分目录、日志可读，
        // 且用 /releases/latest 的 302 目标解析，不消耗 GitHub API 配额。
        string tag = wantLatest ? null : spec;
        Exception resolveError = null;
        if (wantLatest)
        {
            try
            {
                tag = ResolveLatestTag(repo);
            }
            catch (Exception ex)
            {
                resolveError = ex;
            }
        }

        if (tag == null)
        {
            // 解析不出最新版本（离线/被墙/上游改动）：优先沿用本地已缓存的成品，别把构建卡死在网络上
            var reason = resolveError == null ? "未知原因" : resolveError.Message;
            var cachedDir = NewestCachedDir(RootDir, dllName);
            if (cachedDir == null)
            {
                Log.LogError($"解析 CloudRedirect 最新 Release 失败：{reason}；本地也没有可复用的缓存，请检查网络后重试。");
            }
            else
            {
                ResolvedVersion = Path.GetFileName(cachedDir);
                DllPath = Path.Combine(cachedDir, dllName);
                Log.LogWarning($"解析 CloudRedirect 最新 Release 失败（{reason}），本次构建沿用本地缓存 {ResolvedVersion}。");
            }
        }
        else
        {
            ResolvedVersion = tag;
            var destDir = Path.Combine(RootDir, tag);
            var marker = Path.Combine(destDir, ".fetch-ok");
            var dllFile = Path.Combine(destDir, dllName);
            var baseUrl = wantLatest
                ? $"{repo}/releases/latest/download"
                : $"{repo}/releases/download/{tag}";

            string expected = null;
            try
            {
                using var http = new HttpClient();
                http.Timeout = TimeSpan.FromSeconds(60);
                http.DefaultRequestHeaders.TryAddWithoutValidation("User-Agent", "SteamLuaManager-Build");

                // 先取远端 .sha256（几十字节）与本地缓存比对：内容一致说明上游没发新版，直接跳过下载
                var shaText = http.GetStringAsync($"{baseUrl}/{dllName}.sha256").GetAwaiter().GetResult();
                expected = shaText.Split((char[])null, StringSplitOptions.RemoveEmptyEntries)[0].Trim().ToUpperInvariant();

                var cacheOk = File.Exists(marker) && File.Exists(dllFile)
                              && File.ReadAllText(marker).Trim().ToUpperInvariant() == expected
                              && HashFile(dllFile) == expected;
                if (cacheOk)
                {
                    Log.LogMessage(MessageImportance.High, $"cloud_redirect.dll {tag} 已是最新，跳过下载。");
                }
                else
                {
                    Log.LogMessage(MessageImportance.High, $"正在下载 cloud_redirect.dll {tag} ...");
                    var dllBytes = http.GetByteArrayAsync($"{baseUrl}/{dllName}").GetAwaiter().GetResult();
                    using var sha = SHA256.Create();
                    var actual = BitConverter.ToString(sha.ComputeHash(dllBytes)).Replace("-", "").ToUpperInvariant();
                    if (expected != actual)
                    {
                        Log.LogError($"SHA256 校验失败（期望 {expected}，实得 {actual}）");
                    }
                    else
                    {
                        if (Directory.Exists(destDir)) Directory.Delete(destDir, true);
                        Directory.CreateDirectory(destDir);
                        File.WriteAllBytes(dllFile, dllBytes);
                        File.WriteAllText(marker, expected);
                        Log.LogMessage(MessageImportance.High, $"cloud_redirect.dll {tag} 已就绪（SHA256 已验证）。");
                    }
                }
                DllPath = dllFile;
            }
            catch (Exception ex)
            {
                // 网络异常时，只要本地有成品就继续构建（缓存里通常是上次成功拉到的同一 tag）
                if (File.Exists(dllFile))
                {
                    DllPath = dllFile;
                    Log.LogWarning($"联网拉取 cloud_redirect.dll {tag} 失败（{ex.Message}），本次构建沿用本地缓存。");
                }
                else
                {
                    Log.LogError($"拉取 cloud_redirect.dll 失败：{ex.Message}，请检查网络后重试。");
                }
            }
        }

        string ResolveLatestTag(string repoUrl)
        {
            using var handler = new HttpClientHandler { AllowAutoRedirect = false };
            using var http = new HttpClient(handler);
            http.Timeout = TimeSpan.FromSeconds(30);
            http.DefaultRequestHeaders.TryAddWithoutValidation("User-Agent", "SteamLuaManager-Build");
            using var resp = http.GetAsync($"{repoUrl}/releases/latest").GetAwaiter().GetResult();
            var location = resp.Headers.Location == null ? "" : resp.Headers.Location.ToString();
            var idx = location.IndexOf("/tag/", StringComparison.OrdinalIgnoreCase);
            if (idx >= 0)
            {
                var parsed = location.Substring(idx + 5).Trim('/');
                var cut = parsed.IndexOfAny(new[] { '?', '#' });
                if (cut >= 0) parsed = parsed.Substring(0, cut);
                if (parsed.Length > 0) return parsed;
            }
            throw new InvalidOperationException($"未能从 {repoUrl}/releases/latest 解析出版本号（HTTP {(int)resp.StatusCode}）");
        }

        string NewestCachedDir(string root, string file)
        {
            if (!Directory.Exists(root)) return null;
            string best = null;
            var bestStamp = DateTime.MinValue;
            foreach (var dir in Directory.GetDirectories(root))
            {
                var candidate = Path.Combine(dir, file);
                if (!File.Exists(candidate)) continue;
                var stamp = File.GetLastWriteTimeUtc(candidate);
                if (best == null || stamp > bestStamp)
                {
                    best = dir;
                    bestStamp = stamp;
                }
            }
            return best;
        }

        string HashFile(string path)
        {
            using var sha = SHA256.Create();
            return BitConverter.ToString(sha.ComputeHash(File.ReadAllBytes(path))).Replace("-", "").ToUpperInvariant();
        }

        // 无显式 return：收尾的 return !Log.HasLoggedErrors 由任务工厂自动追加，
        // 成功只记 Message（返回 true），失败已记 Error（返回 false）；显式 return 会让它变死代码报 CS0162
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="FetchCloudRedirectDll" BeforeTargets="BeforeBuild">
    <FetchCloudRedirectDll Version="$(CloudRedirectVersion)" RootDir="$(CloudRedirectDllRoot)">
      <Output TaskParameter="DllPath" PropertyName="CloudRedirectDllPath" />
      <Output TaskParameter="ResolvedVersion" PropertyName="CloudRedirectResolvedVersion" />
    </FetchCloudRedirectDll>
    <Copy SourceFiles="$(CloudRedirectDllPath)" DestinationFolder="$(ProjectDir)Resources\CloudRedirectDllPublish" />
    <ZipDirectory SourceDirectory="$(ProjectDir)Resources\CloudRedirectDllPublish"
                  DestinationFile="$(ProjectDir)Resources\CloudRedirectDll.zip"
                  Overwrite="true" />
    <RemoveDir Directories="$(ProjectDir)Resources\CloudRedirectDllPublish" />
  </Target>

  <Target Name="GenerateFeedbackSecrets" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <ResendKeyRaw>$([System.Environment]::GetEnvironmentVariable('RESEND_API_KEY'))</ResendKeyRaw>
      <ResendKeyClean Condition="'$(ResendKeyRaw)' != ''">$(ResendKeyRaw)</ResendKeyClean>
      <ResendKeyClean Condition="'$(ResendKeyRaw)' == ''">MISSING</ResendKeyClean>
    </PropertyGroup>
    <ItemGroup>
      <FeedbackSecretLine Include="// &lt;auto-generated /&gt; Generated at build time from env RESEND_API_KEY. Do not edit. Not committed." />
      <FeedbackSecretLine Include="namespace SteamLuaManager.Services%3B" />
      <FeedbackSecretLine Include="internal static class FeedbackSecrets" />
      <FeedbackSecretLine Include="{" />
      <FeedbackSecretLine Include="    internal const string ResendApiKey = &quot;$(ResendKeyClean)&quot;%3B" />
      <FeedbackSecretLine Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(ProjectDir)obj\Generated" />
    <WriteLinesToFile File="$(ProjectDir)obj\Generated\FeedbackSecrets.g.cs" Lines="@(FeedbackSecretLine)" Overwrite="true" Encoding="UTF-8" />
  </Target>

</Project>
